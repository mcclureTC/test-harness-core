<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_VerdictUntargetedHandleIsInert" Id="{c10cadf8-b2f0-446b-b486-99bb6f4b9537}" SpecialFunc="None">
    <Declaration><![CDATA[// A handle pointing at nothing records nothing, rather than writing into whatever

// journal happens to be nearby.

//

// The runner untargets after every test. Without this holding, a stray call from a

// test that kept the handle would land in the NEXT test's record.
FUNCTION_BLOCK TEST_VerdictUntargetedHandleIsInert IMPLEMENTS I_Test
VAR
	// A private journal and handle, so a DELIBERATE failure can be recorded and

	// inspected without the suite's own verdict ever seeing it. The test itself

	// passes; what it proves is that failing works.
	Subject		  : TestJournal;
	Handle		  : TestVerdict;
	ExpectedCount : UDINT;
	ActualCount	  : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{9e15413b-c0f6-4520-a5e2-c46a53b5cc7c}" />
    <Method Name="Run" Id="{b77ae0a6-9813-4a1d-ae38-e2e192f13426}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Handle.Target(Subject);
Subject.Begin('inert', '');
Handle.AssertTrue(TRUE, 'one real check');
Handle.Untarget();

// Everything below must reach nothing at all.
Handle.AssertTrue(FALSE, 'must not be recorded');
Handle.Fail('must not be recorded');
Handle.ReportError('must not be recorded');
ExpectedCount := 1;
ActualCount	  := Subject.AssertionCount;
Test.AssertEqual(ExpectedCount, ActualCount, 'nothing landed after Untarget');
Subject.Finish(E_TestStatus.Passed);
Test.AssertTrue(Subject.Status = E_TestStatus.Passed, 'and the verdict is untouched');
Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>