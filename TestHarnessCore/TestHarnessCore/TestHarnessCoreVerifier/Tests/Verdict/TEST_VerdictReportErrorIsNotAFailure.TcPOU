<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_VerdictReportErrorIsNotAFailure" Id="{5d30e474-3cd6-47ad-919c-c60dfe729302}" SpecialFunc="None">
    <Declaration><![CDATA[// Errored is distinct from Failed: the code under test was never shown to be
// wrong. A precondition was absent or a target unreachable.
//
// Conflating them sends whoever reads the report hunting a defect that is not
// there.
FUNCTION_BLOCK TEST_VerdictReportErrorIsNotAFailure IMPLEMENTS I_Test
VAR
	// A private journal and handle, so a DELIBERATE failure can be recorded and
	// inspected without the suite's own verdict ever seeing it. The test itself
	// passes; what it proves is that failing works.
	Subject : TestJournal;
	Handle	: TestVerdict;
	ExpectedStatus : E_TestStatus;
	ActualStatus   : E_TestStatus;
	ExpectedKind   : E_FailureKind;
	ActualKind	   : E_FailureKind;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{837da6de-3d55-4ead-8128-db69d7984722}" />
    <Method Name="Run" Id="{b1b284d3-ef6b-48c0-a951-1be7af54bf13}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Handle.Target(Subject);
Subject.Begin('could not run', '');

Handle.ReportError('the axis would not power');

ExpectedKind := E_FailureKind.Environment;
ActualKind	 := Subject.Kind;
Test.AssertEqual(ExpectedKind, ActualKind, 'recorded as environmental');

Subject.Finish(E_TestStatus.Passed);

ExpectedStatus := E_TestStatus.Errored;
ActualStatus   := Subject.Status;
Test.AssertEqual(ExpectedStatus, ActualStatus, 'Errored, not Failed');

Handle.Untarget();

Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>