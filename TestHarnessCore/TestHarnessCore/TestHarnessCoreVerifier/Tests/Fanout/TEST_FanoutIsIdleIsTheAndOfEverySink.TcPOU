<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_FanoutIsIdleIsTheAndOfEverySink" Id="{29a3b6a6-f148-48e2-a1ec-52807935a9ac}" SpecialFunc="None">
    <Declaration><![CDATA[// CI must wait for IsIdle as well as IsComplete. A run finishing and its result
// document reaching disk are different events, and copying between them yields a
// truncated artifact - which reads as a broken pipeline rather than a finished run.
//
// One busy sink is enough to hold the whole fan-out busy.
FUNCTION_BLOCK TEST_FanoutIsIdleIsTheAndOfEverySink IMPLEMENTS I_Test
VAR
	Fanout : TestReporterFanout;
	Quick  : SpyReporter;
	Slow   : SpyReporter;
	Empty  : TestReporterFanout;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{3ad82964-5df7-4781-8123-eb955ec2cf1b}" />
    <Method Name="Run" Id="{0960efd2-f5c7-49a7-8b18-9c7c1ae1e3ee}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Nothing attached: no sink, no pending work.
Test.AssertTrue(Empty.IsIdle, 'an empty fan-out is idle');

Fanout.Attach(Quick);
Fanout.Attach(Slow);
Test.AssertTrue(Fanout.IsIdle, 'idle while both sinks are');

Slow.SetBusy(TRUE);
Test.AssertFalse(Fanout.IsIdle, 'one busy sink holds the whole fan-out busy');

// CyclicLogic is what lets a slow sink finish, so it must keep running.
Fanout.CyclicLogic();
Test.AssertTrue(Slow.CyclicCalls > 0, 'and the busy sink still gets advanced');

Slow.SetBusy(FALSE);
Test.AssertTrue(Fanout.IsIdle, 'idle again once it finishes');

Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>