<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_AssertCompletedWithinCountsCompletedScans" Id="{2ebe1817-15a7-452f-a034-a320c9e52c90}" SpecialFunc="None">
    <Declaration><![CDATA[// AssertCompletedWithin compares against COMPLETED scans - the one in progress is

// not counted, because the journal is ticked after the body runs.

//

// That is documented in I_TestTiming and is exactly the kind of off-by-one nobody

// notices until a scan budget behaves oddly. Here the journal is ticked by hand so

// the count is unambiguous rather than a side effect of how long something took.
FUNCTION_BLOCK TEST_AssertCompletedWithinCountsCompletedScans IMPLEMENTS I_Test
VAR
	// A private journal and handle. The assertion under test is driven into THESE,

	// so its verdict can be inspected without the outer suite ever seeing it.
	Subject : TestJournal;
	Handle	: TestVerdict;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{2a746b55-3dac-4f76-a3f3-6526335103a5}" />
    <Method Name="Run" Id="{fa1efbf4-8aad-4fbd-96ac-aa627de451a8}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Handle.Target(Subject);
Subject.Begin('budget', '');

// Nothing has completed yet.
Handle.AssertCompletedWithin(2, 'nothing has run');
Test.AssertTrue(Subject.Kind = E_FailureKind.None, 'zero completed scans is within two');

// Two scans completed - still within a budget of two.
Subject.Tick();
Subject.Tick();
Handle.AssertCompletedWithin(2, 'two scans is within two');
Test.AssertTrue(Subject.Kind = E_FailureKind.None, 'the boundary itself passes');

// A third takes it past.
Subject.Tick();
Handle.AssertCompletedWithin(2, 'three scans is not within two');
Test.AssertTrue(Subject.Kind = E_FailureKind.Timeout, 'exceeding the budget is a Timeout, not a value mismatch');

// Summary is composed by Finish, not as checks are recorded - a test with forty

// passing checks composes ONE line, at the end. So the journal is finished before

// its text is read.
Subject.Finish(E_TestStatus.Passed);
Test.AssertTrue(FIND(Subject.Summary, 'cycles') > 0, 'and the summary names cycles');
Handle.Untarget();
Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>