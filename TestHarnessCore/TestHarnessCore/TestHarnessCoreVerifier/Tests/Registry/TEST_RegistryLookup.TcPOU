<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_RegistryLookup" Id="{497d9a52-3696-4786-83d6-c6b57615927b}" SpecialFunc="None">
    <Declaration><![CDATA[// Lookup answers with an index or -1. ReRunSingle depends on both answers.
//
// An empty label must not match an unclaimed slot, whose label is also empty.
FUNCTION_BLOCK TEST_RegistryLookup IMPLEMENTS I_Test
VAR
	Registry : TestRegistry<4>;
	Fakes	 : ARRAY[0..2] OF FakeTest;
	Budgets	 : ST_TestBudgets;

	ExpectedIndex : DINT;
	ActualIndex	  : DINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{1b950f53-a033-40cf-9127-cdad9ea6b46e}" />
    <Method Name="Run" Id="{ea28ed54-6417-4ba6-87c2-cd4b64b6aead}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Registry.TryClaim(Fakes[0], 'Alpha', Budgets);
Registry.TryClaim(Fakes[1], 'Beta', Budgets);
Registry.TryClaim(Fakes[2], 'Gamma', Budgets);

ExpectedIndex := 0;
ActualIndex	  := Registry.Lookup('Alpha');
Test.AssertEqual(ExpectedIndex, ActualIndex, 'first label');

ExpectedIndex := 2;
ActualIndex	  := Registry.Lookup('Gamma');
Test.AssertEqual(ExpectedIndex, ActualIndex, 'last label');

ExpectedIndex := -1;
ActualIndex	  := Registry.Lookup('Never registered');
Test.AssertEqual(ExpectedIndex, ActualIndex, 'unknown label is -1');

ExpectedIndex := -1;
ActualIndex	  := Registry.Lookup('');
Test.AssertEqual(ExpectedIndex, ActualIndex, 'empty label is -1');

Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>