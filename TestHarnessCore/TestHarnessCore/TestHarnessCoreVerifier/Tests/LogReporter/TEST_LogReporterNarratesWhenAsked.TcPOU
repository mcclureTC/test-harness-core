<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_LogReporterNarratesWhenAsked" Id="{e36bfafc-c6f1-4cc5-8bc3-5cae5a621945}" SpecialFunc="None">
    <Declaration><![CDATA[// SetVerbosity(TRUE) turns the narration back on, for a rig where the log IS the
// artifact and a passing test that stops appearing is the signal.//
// WHAT THIS CANNOT CHECK: whether the line actually reached the TwinCAT log, or
// what it says. ADSLOGSTR gives no answer back. The counters prove which BRANCH
// was taken; the wording has to be read once, by eye, in the Logged Events window.
// Saying so is better than a test that implies more than it establishes.
FUNCTION_BLOCK TEST_LogReporterNarratesWhenAsked IMPLEMENTS I_Test
VAR
	Sink : TestLogReporter;
	ExpectedCount : UDINT;
	ActualCount	  : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{722e6c6e-21a1-496b-963b-121c97fc7b43}" />
    <Method Name="Run" Id="{0b3fd9b9-54a8-4839-85ea-575440fb3ac6}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Sink.SetVerbosity(TRUE);

Sink.TestFinished(SuiteLabel := 'suite', TestLabel := 'a pass', Location := '',
				  Status := E_TestStatus.Passed, Kind := E_FailureKind.None,
				  Summary := '', ElapsedTime := 0.0, ElapsedCycles := 1, Assertions := 1);

ExpectedCount := 1;
ActualCount	  := Sink.LinesWritten;
Test.AssertEqual(ExpectedCount, ActualCount, 'the pass was narrated');

// And it can be turned off again.
Sink.SetVerbosity(FALSE);
Sink.TestFinished(SuiteLabel := 'suite', TestLabel := 'another pass', Location := '',
				  Status := E_TestStatus.Passed, Kind := E_FailureKind.None,
				  Summary := '', ElapsedTime := 0.0, ElapsedCycles := 1, Assertions := 1);

ActualCount := Sink.LinesWritten;
Test.AssertEqual(ExpectedCount, ActualCount, 'and quiet again afterwards');

Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>