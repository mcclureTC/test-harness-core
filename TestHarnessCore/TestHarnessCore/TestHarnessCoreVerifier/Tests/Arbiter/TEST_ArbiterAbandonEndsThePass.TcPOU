<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_ArbiterAbandonEndsThePass" Id="{2b4e297a-2329-4ca8-b802-f048a6c92c8f}" SpecialFunc="None">
    <Declaration><![CDATA[// Dropping Enable abandons the run. The tests not yet reached are NOT visited: a

// run that stopped half way has not been run, and reporting the remainder as

// passed, failed or skipped would be inventing a result.
FUNCTION_BLOCK TEST_ArbiterAbandonEndsThePass IMPLEMENTS I_Test
VAR
	Registry	  : TestRegistry<3>;
	Arbiter		  : TestArbiter;
	Fakes		  : ARRAY[0..2] OF FakeTest;
	Budgets		  : ST_TestBudgets;
	Active		  : ST_TestSlot;
	ExpectedLabel : T_MaxString;
	ActualLabel	  : T_MaxString;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{2ab82af7-49e2-4e04-b574-fd8d1745eb71}" />
    <Method Name="Run" Id="{1fb173dc-2c5f-42ea-a312-88b50ba7b729}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Registry.TryClaim(Fakes[0], 'Alpha', Budgets);
Registry.TryClaim(Fakes[1], 'Beta', Budgets);
Registry.TryClaim(Fakes[2], 'Gamma', Budgets);
Arbiter.Attach(Registry);
Arbiter.Begin();
Arbiter.Advance();
Active		  := Arbiter.Current;
ActualLabel	  := Active.Label;
ExpectedLabel := 'Alpha';
Test.AssertEqual(ExpectedLabel, ActualLabel, 'first test active');
Arbiter.Abandon();
Test.AssertFalse(Arbiter.HasCurrent, 'nothing active after Abandon');
Test.AssertTrue(Arbiter.IsExhausted, 'pass is over');
Test.AssertFalse(Arbiter.Advance(), 'Beta and Gamma are not visited');
Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>