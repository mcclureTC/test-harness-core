<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_JournalSkippedIsTerminalAndNotRed" Id="{4742b033-cdd3-4d49-9fb7-6cd89af617eb}" SpecialFunc="None">
    <Declaration><![CDATA[// A skipped test is not a failure and must not turn a build red. It is terminal

// immediately: a skipped suite reports complete, or an aggregate containing one

// waits for it forever.
FUNCTION_BLOCK TEST_JournalSkippedIsTerminalAndNotRed IMPLEMENTS I_Test
VAR
	Subject : TestJournal;
	Expired : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{cd95948b-81d5-454c-bbea-0be1959605c8}" />
    <Method Name="Run" Id="{f0390dad-a4f2-4e43-a48e-74123f2e0727}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Subject.MarkSkipped();
Test.AssertTrue(Subject.Status = E_TestStatus.Skipped, 'Skipped');
Test.AssertTrue(Subject.Kind = E_FailureKind.None, 'with no failure kind');

// Terminal means Tick does nothing further.
Expired := Subject.Tick();
Test.AssertFalse(Expired, 'a skipped test has no deadline left to expire');
Test.AssertTrue(Subject.Status = E_TestStatus.Skipped, 'and stays Skipped');
Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>