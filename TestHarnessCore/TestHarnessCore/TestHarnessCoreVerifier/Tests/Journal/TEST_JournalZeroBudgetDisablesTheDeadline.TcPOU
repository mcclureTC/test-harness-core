<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_JournalZeroBudgetDisablesTheDeadline" Id="{97154330-128f-4378-93a8-71f0f5c7e9c1}" SpecialFunc="None">
    <Declaration><![CDATA[// Zero disables. That is why "not specified" needs its own flag and cannot be
// inferred from the value - a long-running rig test may legitimately want no scan
// budget at all.
FUNCTION_BLOCK TEST_JournalZeroBudgetDisablesTheDeadline IMPLEMENTS I_Test
VAR
	Subject : TestJournal;
	Budgets : ST_TestBudgets;
	i		: DINT;
	Expired : BOOL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{654e1c9a-7b6c-4f11-ae33-478b7f1ae427}" />
    <Method Name="Run" Id="{d01383ed-4dd8-4a79-aa00-49aeab444a5c}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Budgets.Body.Cycles	     := 0;
Budgets.Body.IsCyclesSet := TRUE;
Subject.SetBudgets(Budgets);

Subject.Begin('unbounded', '');

FOR i := 1 TO 50 DO
	IF Subject.Tick() THEN
		Expired := TRUE;
	END_IF
END_FOR

Test.AssertFalse(Expired, 'a zero budget never expires');
Test.AssertTrue(Subject.Status = E_TestStatus.Running, 'and the test is still going');

Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>