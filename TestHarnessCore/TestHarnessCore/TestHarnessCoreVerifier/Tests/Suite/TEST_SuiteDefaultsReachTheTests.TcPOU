<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_SuiteDefaultsReachTheTests" Id="{67314c4e-462e-4631-a530-1bb85157e601}" SpecialFunc="None">
    <Declaration><![CDATA[// A suite-wide deadline reaches every test that did not claim one, and reaches it
// when the RUN starts rather than at registration - a default may be set after
// some tests are already registered.
//
// The subject hangs. With no default it would run forever and the watchdog would
// fail this test; with the default applied it times out and is reported Failed.
FUNCTION_BLOCK TEST_SuiteDefaultsReachTheTests IMPLEMENTS I_Test
VAR
	// A private suite, driven one scan per call. The outer test spans scans by
	// returning FALSE - which is the mechanism the inner suite is being asked to
	// drive, one level down.
	Inner	: TestSuite<4>;
	Budgets : ST_TestBudgets;
	Phase	: DINT;
	Scans	: DINT;
	Hangs	 : HangingBodyTest;
	Defaults : ST_TestBudgets;
	ExpectedCount : UDINT;
	ActualCount	  : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{2927a406-62ba-4dc8-8134-216256764438}" />
    <Method Name="Run" Id="{aa248cb2-c7f6-4849-a9e1-41acf1558b04}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Scans := Scans + 1;
IF Scans > 200 THEN
	Test.Fail('the inner suite never completed');
	Run := TRUE;
	RETURN;
END_IF

CASE Phase OF

0:
	Inner.SetLabel('inner');
	// Registered BEFORE the default is set, which is the case that matters.
	Inner.Register(Hangs, 'hangs', Budgets);

	Defaults.Body.Cycles	  := 4;
	Defaults.Body.IsCyclesSet := TRUE;
	Inner.SetDefaults(Defaults);

	Phase := 1;
	Run	  := FALSE;

1:
	IF Inner.Run(Enable := TRUE) THEN
		Phase := 2;
	END_IF
	Run := FALSE;

2:
	ExpectedCount := 4;
	ActualCount	  := Hangs.BodyCalls;
	Test.AssertEqual(ExpectedCount, ActualCount, 'the default budget bounded it');

	ExpectedCount := 1;
	ActualCount	  := Inner.FailedCount;
	Test.AssertEqual(ExpectedCount, ActualCount, 'and it was reported as a failure');

	Test.AssertTrue(Inner.IsComplete, 'the suite completed rather than stalling');

	Run := TRUE;

END_CASE]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>