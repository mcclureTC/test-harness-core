<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TEST_ValueBriefShortens" Id="{d492f4f4-5800-4506-8d40-51762ccaca35}" SpecialFunc="None">
    <Declaration><![CDATA[// NEW, not ported - TestValueBrief did not exist in the original.
//
// It is what keeps a composed diagnostic inside CONCAT's 255-character ceiling:
// two full values plus the words between them do not fit, so the summary gets
// shortened copies while the full values travel in their own fields.
//
// The budget is a constant inside the function rather than a parameter, so that
// four call sites cannot carry four copies of the number. That makes the exact
// value an implementation detail - these tests assert the BEHAVIOUR, not the 80.
FUNCTION_BLOCK TEST_ValueBriefShortens IMPLEMENTS I_Test
VAR
	Short	  : T_MaxString := 'homed';
	Long	  : T_MaxString;
	Result	  : T_MaxString;
	Empty	  : T_MaxString := '';
	i		  : DINT;

	ExpectedText : T_MaxString;
	ActualText	 : T_MaxString;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{ab51f358-968b-4ebd-adb6-675654f24452}" />
    <Method Name="Run" Id="{92eefca7-0958-4599-9583-151f7a867739}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// A value comfortably past any sane budget.
Long := '';
FOR i := 1 TO 20 DO
	Long := CONCAT(Long, 'ABCDEFGHIJ');
END_FOR

// --- short values pass through untouched -----------------------------------
ExpectedText := Short;
ActualText	 := TestValueBrief(Short);
Test.AssertEqual(ExpectedText, ActualText, 'a short value is returned unchanged');

ExpectedText := Empty;
ActualText	 := TestValueBrief(Empty);
Test.AssertEqual(ExpectedText, ActualText, 'and so is an empty one');

// --- long values are shortened and marked ----------------------------------
Result := TestValueBrief(Long);
Test.AssertTrue(LEN(Result) < LEN(Long), 'a long value is shortened');
Test.AssertTrue(FIND(Result, '...') > 0, 'and marked with an ellipsis');

// The point of the budget: two of these plus the words between them must still
// fit in a T_MaxString, which CONCAT cannot exceed.
Test.AssertTrue(LEN(Result) <= 100, 'shortened well inside the 255 ceiling');

// The start of the value survives, which is what makes it useful at all.
Test.AssertTrue(FIND(Result, 'ABCDEFGHIJ') = 1, 'the beginning of the value is kept');

Run := TRUE;]]></ST>
      </Implementation>
    </Method>
  </POU>
</TcPlcObject>