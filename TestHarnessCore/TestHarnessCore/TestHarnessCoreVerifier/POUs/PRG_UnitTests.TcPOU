<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="PRG_UnitTests" Id="{18f2ab95-e103-4ad6-aba6-6cad4a51f263}" SpecialFunc="None">
    <Declaration><![CDATA[// The composition root: what is registered, and the suite that runs it.
//
// READ THESE, in the online view:
//
//   Complete   TRUE once every test has finished
//   Outcome    Passed if the library is sound
//   Total      68 - assert this. A test that stops being registered vanishes
//              silently, and CI sees fewer passes rather than a failure
//   Passed / Failed / Errors / Skipped
//
// Failed above zero names a real defect in TestHarnessCore. Errors above zero
// means the framework itself could not do something and no result in the run can
// be trusted until it is explained.
//
// THE FAILURE PATH IS EXERCISED, not assumed. The Verdict tests drive DELIBERATE
// failures into a private journal; the Suite tests register doubles that fail and
// error on purpose; the JUnit tests write to a folder that does not exist. They
// all pass. What they prove is that going wrong works - without them, a wall of
// green would only show that nothing objected.
//
// THE RUNNER, SUITE AND JUNIT TESTS ARE MULTI-SCAN. Each holds a private object and
// steps it one scan per call, returning FALSE until it finishes - the same
// mechanism they are verifying, one level down. Each carries a watchdog, so a
// defect that never completes fails its own test instead of hanging everything and
// looking like a broken verifier.
//
// THIS SUITE STILL ATTACHES NO REPORTER, though three now exist. The reporter tests
// drive their own instances, so a reporting defect cannot be mistaken for a harness
// defect and the counts below remain the whole result.
//
// TWO THINGS NO TEST HERE CAN ESTABLISH, both needing one look by eye:
//   - the wording of log lines and events, in the Logged Events window
//   - whether the JUnit document is well formed and CI can parse it. Open
//     C:\ProgramData\Beckhoff\TwinCAT\3.1\Boot\TestHarnessCoreVerifier.xml
PROGRAM PRG_UnitTests
VAR
	Suite	: TestSuite<80>;
	Budgets : ST_TestBudgets;
	Wired	: BOOL;

	// -- Registry --
	registryCapacityAndOverflow	: TEST_RegistryCapacityAndOverflow;
	registryRejectsDuplicateLabel	: TEST_RegistryRejectsDuplicateLabel;
	registryRejectsEmptyLabelAndNullTest	: TEST_RegistryRejectsEmptyLabelAndNullTest;
	registryClosesRegistration	: TEST_RegistryClosesRegistration;
	registryLookup	: TEST_RegistryLookup;
	registryPreservesOrder	: TEST_RegistryPreservesOrder;
	registrySlotCarriesItsIndex	: TEST_RegistrySlotCarriesItsIndex;
	registryResolvesOptionalHooks	: TEST_RegistryResolvesOptionalHooks;
	registryJournalsArePerSlot	: TEST_RegistryJournalsArePerSlot;
	registryJournalRejectsBadIndex	: TEST_RegistryJournalRejectsBadIndex;

	// -- Arbiter --
	arbiterVisitsEveryTestOnce	: TEST_ArbiterVisitsEveryTestOnce;
	arbiterCurrentIsNullWhenNothingActive	: TEST_ArbiterCurrentIsNullWhenNothingActive;
	arbiterEmptyPassIsComplete	: TEST_ArbiterEmptyPassIsComplete;
	arbiterAbandonEndsThePass	: TEST_ArbiterAbandonEndsThePass;
	arbiterNotExhaustedWhileLastTestRuns	: TEST_ArbiterNotExhaustedWhileLastTestRuns;
	arbiterRestartsFromTheBeginning	: TEST_ArbiterRestartsFromTheBeginning;

	// -- Verdict --
	verdictRecordsAFailure	: TEST_VerdictRecordsAFailure;
	verdictPassDoesNotOvertakeAFailure	: TEST_VerdictPassDoesNotOvertakeAFailure;
	verdictZeroChecksIsErrored	: TEST_VerdictZeroChecksIsErrored;
	verdictReportErrorIsNotAFailure	: TEST_VerdictReportErrorIsNotAFailure;
	verdictFailIsAPlainFailure	: TEST_VerdictFailIsAPlainFailure;
	verdictSummaryLeadsWithTheStepLabel	: TEST_VerdictSummaryLeadsWithTheStepLabel;
	verdictFirstFailureWinsTheSummary	: TEST_VerdictFirstFailureWinsTheSummary;
	verdictUntargetedHandleIsInert	: TEST_VerdictUntargetedHandleIsInert;

	// -- Journal --
	journalTimesOutOnCycles	: TEST_JournalTimesOutOnCycles;
	journalZeroBudgetDisablesTheDeadline	: TEST_JournalZeroBudgetDisablesTheDeadline;
	journalDefaultsFillOnlyWhatWasNotClaimed	: TEST_JournalDefaultsFillOnlyWhatWasNotClaimed;
	journalResetKeepsWhatWasRegistered	: TEST_JournalResetKeepsWhatWasRegistered;
	journalSkippedIsTerminalAndNotRed	: TEST_JournalSkippedIsTerminalAndNotRed;

	// -- Runner --
	runnerDrivesThePhasesInOrder	: TEST_RunnerDrivesThePhasesInOrder;
	runnerRunsAMultiScanBody	: TEST_RunnerRunsAMultiScanBody;
	runnerSetupFailureSkipsTheBody	: TEST_RunnerSetupFailureSkipsTheBody;
	runnerSetupDoesNotSpendTheBodyBudget	: TEST_RunnerSetupDoesNotSpendTheBodyBudget;
	runnerBodyDeadlineFires	: TEST_RunnerBodyDeadlineFires;
	runnerSetupDeadlineFires	: TEST_RunnerSetupDeadlineFires;
	runnerTeardownOverrunKeepsTheVerdict	: TEST_RunnerTeardownOverrunKeepsTheVerdict;
	runnerAbandonMakesOneFinalCall	: TEST_RunnerAbandonMakesOneFinalCall;
	runnerRefusesAnEmptySlot	: TEST_RunnerRefusesAnEmptySlot;

	// -- Suite --
	suiteRunsEveryRegisteredTest	: TEST_SuiteRunsEveryRegisteredTest;
	suiteSeparatesFailuresFromErrors	: TEST_SuiteSeparatesFailuresFromErrors;
	suiteClosesRegistrationOnFirstEnable	: TEST_SuiteClosesRegistrationOnFirstEnable;
	suiteRejectedRegistrationIsNeverSilent	: TEST_SuiteRejectedRegistrationIsNeverSilent;
	suiteSkipMarksEverythingSkipped	: TEST_SuiteSkipMarksEverythingSkipped;
	suiteReRunRepeatsTheRegisteredSet	: TEST_SuiteReRunRepeatsTheRegisteredSet;
	suiteReRunSingleRecordsNothing	: TEST_SuiteReRunSingleRecordsNothing;
	suiteWithNothingRegisteredIsComplete	: TEST_SuiteWithNothingRegisteredIsComplete;
	suiteWithNoLabelIsAFrameworkError	: TEST_SuiteWithNoLabelIsAFrameworkError;
	suiteDefaultsReachTheTests	: TEST_SuiteDefaultsReachTheTests;

	// -- Fanout --
	fanoutNotifiesEverySinkInOrder	: TEST_FanoutNotifiesEverySinkInOrder;
	fanoutOnlyChecksGoToDetailSinks	: TEST_FanoutOnlyChecksGoToDetailSinks;
	fanoutIsIdleIsTheAndOfEverySink	: TEST_FanoutIsIdleIsTheAndOfEverySink;
	fanoutSuspendSilencesEverything	: TEST_FanoutSuspendSilencesEverything;
	fanoutRefusesBeyondCapacityAndTellsTheRest	: TEST_FanoutRefusesBeyondCapacityAndTellsTheRest;
	fanoutCarriesTheSuiteResultThrough	: TEST_FanoutCarriesTheSuiteResultThrough;

	// -- LogReporter --
	logReporterIsQuietAboutPasses	: TEST_LogReporterIsQuietAboutPasses;
	logReporterWritesFailuresAndErrors	: TEST_LogReporterWritesFailuresAndErrors;
	logReporterNarratesWhenAsked	: TEST_LogReporterNarratesWhenAsked;
	logReporterAlwaysWritesFrameworkErrors	: TEST_LogReporterAlwaysWritesFrameworkErrors;
	logReporterSummarisesASuite	: TEST_LogReporterSummarisesASuite;

	// -- EventReporter --
	eventReporterSendsAndDoesNotFail	: TEST_EventReporterSendsAndDoesNotFail;
	eventReporterIsQuietAboutPasses	: TEST_EventReporterIsQuietAboutPasses;
	eventReporterRaisesEachOutcomeOnce	: TEST_EventReporterRaisesEachOutcomeOnce;
	eventReporterWorksThroughTheFanout	: TEST_EventReporterWorksThroughTheFanout;

	// -- JUnitReporter --
	jUnitReporterWritesTheDocument	: TEST_JUnitReporterWritesTheDocument;
	jUnitReporterIsBusyWhileWriting	: TEST_JUnitReporterIsBusyWhileWriting;
	jUnitReporterReportsAFailedWrite	: TEST_JUnitReporterReportsAFailedWrite;
	jUnitReporterRefusesWithNoPath	: TEST_JUnitReporterRefusesWithNoPath;
	jUnitReporterWritesNothingWhenNothingRan	: TEST_JUnitReporterWritesNothingWhenNothingRan;

	// -- the result, for the watch window ---------------------------------------
	Complete : BOOL;
	Outcome	 : E_RunOutcome;
	Total	 : UDINT;
	Passed	 : UDINT;
	Failed	 : UDINT;
	Errors	 : UDINT;
	Skipped	 : UDINT;
	Duration : LREAL;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[IF NOT Wired THEN
	Wired := TRUE;

	Suite.SetLabel('TestHarnessCore');

	// Registry
	Suite.Register(registryCapacityAndOverflow, 'Registry: capacity and overflow', Budgets);
	Suite.Register(registryRejectsDuplicateLabel, 'Registry: rejects a duplicate label', Budgets);
	Suite.Register(registryRejectsEmptyLabelAndNullTest, 'Registry: rejects an empty label and a null test', Budgets);
	Suite.Register(registryClosesRegistration, 'Registry: closes registration on first enable', Budgets);
	Suite.Register(registryLookup, 'Registry: lookup by label', Budgets);
	Suite.Register(registryPreservesOrder, 'Registry: preserves registration order', Budgets);
	Suite.Register(registrySlotCarriesItsIndex, 'Registry: a slot carries its own index', Budgets);
	Suite.Register(registryResolvesOptionalHooks, 'Registry: resolves the optional hooks independently', Budgets);
	Suite.Register(registryJournalsArePerSlot, 'Registry: journals are per slot and live', Budgets);
	Suite.Register(registryJournalRejectsBadIndex, 'Registry: an out-of-range journal is invalid', Budgets);

	// Arbiter
	Suite.Register(arbiterVisitsEveryTestOnce, 'Arbiter: visits every test once, in order', Budgets);
	Suite.Register(arbiterCurrentIsNullWhenNothingActive, 'Arbiter: current is null when nothing is active', Budgets);
	Suite.Register(arbiterEmptyPassIsComplete, 'Arbiter: an empty pass is complete, not stuck', Budgets);
	Suite.Register(arbiterAbandonEndsThePass, 'Arbiter: abandon does not visit the rest', Budgets);
	Suite.Register(arbiterNotExhaustedWhileLastTestRuns, 'Arbiter: not exhausted while the last test runs', Budgets);
	Suite.Register(arbiterRestartsFromTheBeginning, 'Arbiter: begin restarts from the first test', Budgets);

	// Verdict
	Suite.Register(verdictRecordsAFailure, 'Verdict: a mismatched check is recorded as a failure', Budgets);
	Suite.Register(verdictPassDoesNotOvertakeAFailure, 'Verdict: a pass cannot undo a failure', Budgets);
	Suite.Register(verdictZeroChecksIsErrored, 'Verdict: finishing with no checks is Errored', Budgets);
	Suite.Register(verdictReportErrorIsNotAFailure, 'Verdict: ReportError produces Errored, not Failed', Budgets);
	Suite.Register(verdictFailIsAPlainFailure, 'Verdict: Fail produces Failed', Budgets);
	Suite.Register(verdictSummaryLeadsWithTheStepLabel, 'Verdict: the summary leads with the step label', Budgets);
	Suite.Register(verdictFirstFailureWinsTheSummary, 'Verdict: the first failure wins the summary', Budgets);
	Suite.Register(verdictUntargetedHandleIsInert, 'Verdict: an untargeted handle records nothing', Budgets);

	// Journal
	Suite.Register(journalTimesOutOnCycles, 'Journal: a scan budget expires and records itself', Budgets);
	Suite.Register(journalZeroBudgetDisablesTheDeadline, 'Journal: a zero budget never expires', Budgets);
	Suite.Register(journalDefaultsFillOnlyWhatWasNotClaimed, 'Journal: defaults fill only unclaimed units', Budgets);
	Suite.Register(journalResetKeepsWhatWasRegistered, 'Journal: reset clears the verdict, keeps the budgets', Budgets);
	Suite.Register(journalSkippedIsTerminalAndNotRed, 'Journal: skipped is terminal and not a failure', Budgets);

	// Runner
	Suite.Register(runnerDrivesThePhasesInOrder, 'Runner: setup, body, teardown, each once, in order', Budgets);
	Suite.Register(runnerRunsAMultiScanBody, 'Runner: a multi-scan body is called until it finishes', Budgets);
	Suite.Register(runnerSetupFailureSkipsTheBody, 'Runner: a failed setup skips the body but not teardown', Budgets);
	Suite.Register(runnerSetupDoesNotSpendTheBodyBudget, 'Runner: setup does not spend the body scan budget', Budgets);
	Suite.Register(runnerBodyDeadlineFires, 'Runner: the body deadline stops a hanging test', Budgets);
	Suite.Register(runnerSetupDeadlineFires, 'Runner: setup has its own deadline', Budgets);
	Suite.Register(runnerTeardownOverrunKeepsTheVerdict, 'Runner: a teardown overrun does not change the verdict', Budgets);
	Suite.Register(runnerAbandonMakesOneFinalCall, 'Runner: abandon makes one final call and skips teardown', Budgets);
	Suite.Register(runnerRefusesAnEmptySlot, 'Runner: an empty slot is refused', Budgets);

	// Suite
	Suite.Register(suiteRunsEveryRegisteredTest, 'Suite: runs every registered test, once', Budgets);
	Suite.Register(suiteSeparatesFailuresFromErrors, 'Suite: failures and errors are counted apart', Budgets);
	Suite.Register(suiteClosesRegistrationOnFirstEnable, 'Suite: registration closes on first enable', Budgets);
	Suite.Register(suiteRejectedRegistrationIsNeverSilent, 'Suite: a rejected registration is never silent', Budgets);
	Suite.Register(suiteSkipMarksEverythingSkipped, 'Suite: Skip marks everything skipped and completes', Budgets);
	Suite.Register(suiteReRunRepeatsTheRegisteredSet, 'Suite: a re-run repeats the registered set', Budgets);
	Suite.Register(suiteReRunSingleRecordsNothing, 'Suite: an individual re-run records nothing', Budgets);
	Suite.Register(suiteWithNothingRegisteredIsComplete, 'Suite: an empty suite is complete, not red', Budgets);
	Suite.Register(suiteWithNoLabelIsAFrameworkError, 'Suite: an unnamed suite is a framework error', Budgets);
	Suite.Register(suiteDefaultsReachTheTests, 'Suite: suite defaults reach every unclaimed test', Budgets);

	// Fanout
	Suite.Register(fanoutNotifiesEverySinkInOrder, 'Fanout: every sink is notified, in attachment order', Budgets);
	Suite.Register(fanoutOnlyChecksGoToDetailSinks, 'Fanout: only detail sinks receive checks', Budgets);
	Suite.Register(fanoutIsIdleIsTheAndOfEverySink, 'Fanout: IsIdle is the AND of every sink', Budgets);
	Suite.Register(fanoutSuspendSilencesEverything, 'Fanout: Suspend silences notifications but not CyclicLogic', Budgets);
	Suite.Register(fanoutRefusesBeyondCapacityAndTellsTheRest, 'Fanout: attachment beyond capacity is refused and reported', Budgets);
	Suite.Register(fanoutCarriesTheSuiteResultThrough, 'Fanout: SuiteFinished carries the live read model', Budgets);

	// LogReporter
	Suite.Register(logReporterIsQuietAboutPasses, 'LogReporter: quiet about passes by default', Budgets);
	Suite.Register(logReporterWritesFailuresAndErrors, 'LogReporter: failures and errors are written and counted apart', Budgets);
	Suite.Register(logReporterNarratesWhenAsked, 'LogReporter: verbosity turns narration on and off', Budgets);
	Suite.Register(logReporterAlwaysWritesFrameworkErrors, 'LogReporter: framework errors are never suppressed', Budgets);
	Suite.Register(logReporterSummarisesASuite, 'LogReporter: one line per suite, carrying the counts', Budgets);

	// EventReporter
	Suite.Register(eventReporterSendsAndDoesNotFail, 'EventReporter: an event is accepted and no HRESULT is returned', Budgets);
	Suite.Register(eventReporterIsQuietAboutPasses, 'EventReporter: quiet about passes until narration is asked for', Budgets);
	Suite.Register(eventReporterRaisesEachOutcomeOnce, 'EventReporter: one event per notification, none raised twice', Budgets);
	Suite.Register(eventReporterWorksThroughTheFanout, 'EventReporter: it sits behind the fan-out beside the log sink', Budgets);

	// JUnitReporter
	Suite.Register(jUnitReporterWritesTheDocument, 'JUnitReporter: the document reaches disk', Budgets);
	Suite.Register(jUnitReporterIsBusyWhileWriting, 'JUnitReporter: IsIdle is FALSE until the file lands', Budgets);
	Suite.Register(jUnitReporterReportsAFailedWrite, 'JUnitReporter: a failed write is counted and reported (R3)', Budgets);
	Suite.Register(jUnitReporterRefusesWithNoPath, 'JUnitReporter: no path set is a failure, not silence', Budgets);
	Suite.Register(jUnitReporterWritesNothingWhenNothingRan, 'JUnitReporter: an empty run produces no document', Budgets);

END_IF

Suite.Run(Enable := TRUE);

Complete := Suite.IsComplete;
Outcome	 := Suite.Outcome;
Total	 := Suite.TestCount;
Passed	 := Suite.PassedCount;
Failed	 := Suite.FailedCount;
Errors	 := Suite.ErrorCount;
Skipped	 := Suite.SkippedCount;
Duration := Suite.TotalDuration;]]></ST>
    </Implementation>
  </POU>
</TcPlcObject>