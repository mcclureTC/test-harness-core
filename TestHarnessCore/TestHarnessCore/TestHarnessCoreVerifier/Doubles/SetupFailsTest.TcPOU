<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="SetupFailsTest" Id="{cf32daee-23a9-48d0-9796-d38ed9bcf0cb}" SpecialFunc="None">
    <Declaration><![CDATA[// Setup records a failure and completes. The body must NEVER be called - a test
// whose fixture never came up has not been exercised, and reporting it as a failed
// check would be a lie - but teardown must still run.
FUNCTION_BLOCK SetupFailsTest IMPLEMENTS I_Test, I_TestSetup, I_TestTeardown
VAR
	_BodyCalls	   : UDINT;
	_TeardownCalls : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{f935e00a-a2a2-450d-8dce-3fd0e5c141eb}" />
    <Folder Name="I_TestSetup" Id="{33bf0ecf-48d5-4754-b51a-2558cf8394b2}" />
    <Folder Name="I_TestTeardown" Id="{eb4965be-e32f-4e8f-9196-9a98de1eac34}" />
    <Property Name="BodyCalls" Id="{9dc58128-c7cb-47f1-9bc6-894b0f405629}">
      <Declaration><![CDATA[// Must be 0. Anything else means a failed fixture was treated as a working one.
PROPERTY BodyCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{86794ac4-b561-464f-8ce2-4bf88e31e991}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[BodyCalls := _BodyCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Run" Id="{c1989bfd-cba3-42b9-91c8-f37653047868}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF Enable THEN
	_BodyCalls := _BodyCalls + 1;
	Test.AssertTrue(TRUE, 'the body should never reach this');
END_IF
Run := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Setup" Id="{a10534db-c319-4436-b246-f583725d67c8}" FolderPath="I_TestSetup\">
      <Declaration><![CDATA[METHOD Setup : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Test.Fail('the fixture could not be brought up');
Setup := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Teardown" Id="{63bd8537-fb21-4521-b7d1-ca71c765d70a}" FolderPath="I_TestTeardown\">
      <Declaration><![CDATA[METHOD Teardown : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TeardownCalls := _TeardownCalls + 1;
Teardown := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="TeardownCalls" Id="{0bb1c684-42ad-4c0d-9ba3-19918e926791}">
      <Declaration><![CDATA[// Must be 1. Teardown is guaranteed whatever the verdict.
PROPERTY TeardownCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{25ce9da8-e084-4564-8296-2a8400bf4098}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TeardownCalls := _TeardownCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>