<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="HangingBodyTest" Id="{62dac601-a811-457d-b1f8-1f0aa2797d00}" SpecialFunc="None">
    <Declaration><![CDATA[// A body that never finishes. The deadline must stop it - this is the failure

// mode the whole timeout mechanism exists for.

//

// Also counts the abandon call, because a hung test is exactly the one that will

// not answer a falling Enable either. The runner makes ONE such call and ignores

// the return.
FUNCTION_BLOCK HangingBodyTest IMPLEMENTS I_Test
VAR
	_BodyCalls	  : UDINT;
	_AbandonCalls : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{e09fc6c6-8b48-41b2-b0c2-50f390902551}" />
    <Property Name="AbandonCalls" Id="{3794b5df-afaf-438b-ae0b-12148b75d728}">
      <Declaration><![CDATA[// Exactly 1 after an abandon, however many scans the runner has left.
PROPERTY AbandonCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{a05f78b6-1cc9-4f1f-9537-a9b1dc13001c}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[AbandonCalls := _AbandonCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="BodyCalls" Id="{3eef9d2f-42f3-4a8d-97bf-31bfcd7a6da4}">
      <Declaration><![CDATA[PROPERTY BodyCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{f804a4fc-20fa-46fb-9dfc-e9a39ea6dee1}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[BodyCalls := _BodyCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Run" Id="{8cbfa450-2b87-47bb-a320-7273765da05b}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT Enable THEN
	_AbandonCalls := _AbandonCalls + 1;

	// Deliberately does NOT report itself finished. A test that hung will not

	// answer this either, and the runner must not wait for it.
	Run := FALSE;
	RETURN;
END_IF

_BodyCalls := _BodyCalls + 1;
Run		   := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="TeardownCalls" Id="{9b4aeb3e-74c4-4267-aa88-c7f5f88a48bd}">
      <Declaration><![CDATA[// Always 0 - this double implements no teardown. Declared so a test can assert

// that abandonment did not somehow invent one.
PROPERTY TeardownCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{ea020230-6cd9-4590-9d0b-5aa5e0d6b22d}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[TeardownCalls := 0;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>