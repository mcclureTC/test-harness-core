<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="FakeTest" Id="{bb32eb41-858e-40a2-af8d-54159fb5d777}" SpecialFunc="None">
    <Declaration><![CDATA[// A test that implements I_Test and nothing else.
//
// The null case for hook resolution: Setup, Teardown and Location must all come
// back null for this one.
FUNCTION_BLOCK FakeTest IMPLEMENTS I_Test
VAR
	_RunCount : UDINT;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Test" Id="{03c00bbd-5fd7-425b-99e8-8ddd7726e6c6}" />
    <Method Name="Run" Id="{9ecc2efa-3db7-4c0f-a01d-61e087249b91}" FolderPath="I_Test\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RunCount := _RunCount + 1;
Run := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="RunCount" Id="{f7710d7f-8bb6-4ebe-a71b-83c05735bc3a}">
      <Declaration><![CDATA[// Should stay 0 in registry and arbiter tests: neither object calls a test.
PROPERTY RunCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{dc44f5e5-6ab3-4910-aee9-d58de6f4b6ee}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RunCount := _RunCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>