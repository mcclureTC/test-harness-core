      </Get>
    </Property>
    <Property Name="IsIdle" Id="{c47732be-ea50-4e69-9948-e43eba0e0cc0}" FolderPath="I_TestReporter\">
      <Declaration><![CDATA[// FALSE while this spy claims work in flight. The fan-out ANDs every sink.
PROPERTY IsIdle : BOOL]]></Declaration>
      <Get Name="Get" Id="{7e5982d5-e02c-4eae-a553-ee9f6758f079}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsIdle := NOT _IsBusy;]]></ST>
        </Implementation>
      </Get>
    </Property>
