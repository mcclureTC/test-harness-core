    </Property>
    <Property Name="LastTestLabel" Id="{9504cb73-5c49-4bc6-ae0b-66345fe3fd39}">
      <Declaration><![CDATA[PROPERTY LastTestLabel : T_MaxString]]></Declaration>
      <Get Name="Get" Id="{7ca8da91-7f6e-4f0d-9805-1db712f39355}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[LastTestLabel := _LastTestLabel;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RunFinished" Id="{8e62adbe-2b75-489b-8e91-6b3b85d60477}" FolderPath="I_TestReporter\">
      <Declaration><![CDATA[METHOD RunFinished
VAR_INPUT
	Status	   : I_TestRunStatus;
	TargetInfo : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RunFinishedCalls := _RunFinishedCalls + 1;]]></ST>
      </Implementation>
    </Method>
    <Property Name="RunFinishedCalls" Id="{bd9f3b8a-6c15-40bc-8503-343ca60818d2}">
      <Declaration><![CDATA[PROPERTY RunFinishedCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{9970d8ee-acaa-42d3-87ad-a1a95d29b736}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RunFinishedCalls := _RunFinishedCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="RunStarted" Id="{d394cb4a-705e-454c-b38b-1a12efcc9322}" FolderPath="I_TestReporter\">
      <Declaration><![CDATA[// Counted, and the label kept - so a test can prove the run announced itself
// BEFORE anything else in it arrived, which is the whole point of the call.
METHOD RunStarted
VAR_INPUT
	Label	   : T_MaxString;
	TargetInfo : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_RunStartedCalls := _RunStartedCalls + 1;
_StartedBeforeAnything := (_TestFinishedCalls = 0) AND (_SuiteFinishedCalls = 0);]]></ST>
      </Implementation>
    </Method>
    <Property Name="RunStartedCalls" Id="{fce11a79-c577-43d9-8554-9ab2f501c98e}">
      <Declaration><![CDATA[PROPERTY RunStartedCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{144e7e30-92f1-4040-a62e-160d0c00b2b0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RunStartedCalls := _RunStartedCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SetBusy" Id="{59cf7a44-723b-4a89-b398-166a4c85d503}">
      <Declaration><![CDATA[// Pretend to have asynchronous work in flight, so IsIdle can be checked without a
// real file write.
METHOD SetBusy
VAR_INPUT
	Busy : BOOL;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsBusy := Busy;]]></ST>
      </Implementation>
    </Method>
    <Property Name="StartedBeforeAnything" Id="{b9947f3f-27a8-4fc6-989a-be358c7c8864}">
      <Declaration><![CDATA[// TRUE if RunStarted arrived before any test or suite result. The ordering IS the
// contract - a sink that opens a document on this call has nowhere to put a result
// that arrived first.
PROPERTY StartedBeforeAnything : BOOL]]></Declaration>
      <Get Name="Get" Id="{33bb6a23-aa93-4d06-a0fe-d0462cec7f14}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StartedBeforeAnything := _StartedBeforeAnything;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="StartedBeforeChecks" Id="{0985fc30-f9d9-4250-b868-46ad8808c3df}">
      <Declaration><![CDATA[// TRUE if TestStarted arrived before any check did. The ordering guarantee is the
// whole reason TestStarted exists - a sink building a document has nowhere to put
// a check until it has been told to open an element.
PROPERTY StartedBeforeChecks : BOOL]]></Declaration>
      <Get Name="Get" Id="{57578b07-b1df-41d9-a8c6-fc3ca8ea0600}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[StartedBeforeChecks := _StartedBeforeChecks;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="SuiteFinished" Id="{f5c199b3-c851-4f54-8b47-919f47c03ab4}" FolderPath="I_TestReporter\">
      <Declaration><![CDATA[METHOD SuiteFinished
VAR_INPUT
	Status : I_TestRunStatus;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_SuiteFinishedCalls := _SuiteFinishedCalls + 1;
IF Status <> 0 THEN
	_LastSuiteOutcome := Status.Outcome;
	_LastSuitePassed  := Status.PassedCount;
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="SuiteFinishedCalls" Id="{a0b13905-0246-45c6-b0d9-8c87939f9c76}">
      <Declaration><![CDATA[PROPERTY SuiteFinishedCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{8c4c8a95-42ba-4ca6-8285-430fd23ddd42}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SuiteFinishedCalls := _SuiteFinishedCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TestFinished" Id="{da2b751b-a54a-49ec-bc33-e202ed5885e6}" FolderPath="I_TestReporter\">
      <Declaration><![CDATA[METHOD TestFinished
VAR_INPUT
	SuiteLabel	  : T_MaxString;
	TestLabel	  : T_MaxString;
	Location	  : T_MaxString;
	Status		  : E_TestStatus;
	Kind		  : E_FailureKind;
	Summary		  : T_MaxString;
	ElapsedTime	  : LREAL;
	ElapsedCycles : UDINT;
	Assertions	  : UDINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TestFinishedCalls := _TestFinishedCalls + 1;
_LastTestLabel	   := TestLabel;
_LastSuiteLabel	   := SuiteLabel;
_LastStatus		   := Status;
_LastSummary	   := Summary;

// Order of notification is order of attachment. Each spy stamps itself into a
// shared witness so a test can read the sequence back.
IF _Witness <> 0 THEN
	_Witness.Note(_Ordinal);
END_IF]]></ST>
      </Implementation>
    </Method>
    <Property Name="TestFinishedCalls" Id="{190ac2fc-daa5-4d7b-8423-a03bc43d84e7}">
      <Declaration><![CDATA[PROPERTY TestFinishedCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{aded91bb-c84e-4100-a523-6c775346dccc}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TestFinishedCalls := _TestFinishedCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="TestStarted" Id="{f6e38227-38ee-4605-83c5-62d6da68f008}" FolderPath="I_TestDetailSink\">
      <Declaration><![CDATA[METHOD TestStarted
VAR_INPUT
	SuiteLabel : T_MaxString;
	TestLabel  : T_MaxString;
	Location   : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_TestStartedCalls := _TestStartedCalls + 1;
_StartedBeforeChecks := (_CheckCalls = 0);]]></ST>
      </Implementation>
    </Method>
    <Property Name="TestStartedCalls" Id="{fc102957-6f61-4493-b346-918bdc8b6c2a}">
      <Declaration><![CDATA[PROPERTY TestStartedCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{18a66005-5351-45a6-88ed-0e3cbb290d6d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TestStartedCalls := _TestStartedCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>