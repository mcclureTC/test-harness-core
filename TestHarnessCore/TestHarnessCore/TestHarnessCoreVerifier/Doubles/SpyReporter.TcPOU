<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="SpyReporter" Id="{e0a15c8b-7328-4369-b37d-81a0c3cb775f}" SpecialFunc="None">
    <Declaration><![CDATA[// A reporter that records what it was told, and nothing else.
//
// Implements BOTH faces: I_TestReporter for verdicts, I_TestDetailSink for
// individual checks. VerdictOnlyReporter is the counterpart that implements only
// the first, and the pair together are what proves the fan-out asks each sink what
// it actually wants rather than calling everything on everyone.
FUNCTION_BLOCK SpyReporter IMPLEMENTS I_TestReporter, I_TestDetailSink
VAR
	_CyclicCalls		 : UDINT;
	_TestFinishedCalls	 : UDINT;
	_SuiteFinishedCalls	 : UDINT;
	_RunFinishedCalls	 : UDINT;
	_RunStartedCalls	 : UDINT;
	_StartedBeforeAnything : BOOL;
	_FrameworkErrorCalls : UDINT;
	_TestStartedCalls	 : UDINT;
	_CheckCalls			 : UDINT;
	_CheckPassedCalls	 : UDINT;
	_CheckFailedCalls	 : UDINT;

	_LastTestLabel	  : T_MaxString;
	_LastSuiteLabel	  : T_MaxString;
	_LastSummary	  : T_MaxString;
	_LastExpected	  : T_MaxString;
	_LastActual		  : T_MaxString;
	_LastErrorSource  : T_MaxString;
	_LastErrorMessage : T_MaxString;
	_LastStatus		  : E_TestStatus;
	_LastSuiteOutcome : E_RunOutcome;
	_LastSuitePassed  : UDINT;

	_StartedBeforeChecks : BOOL;
	_IsBusy				 : BOOL;

	_Ordinal : UDINT;
	_Witness : I_ProbeWitness;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[]]></ST>
    </Implementation>
    <Folder Name="I_Cyclic" Id="{0eea7dc9-1472-44a7-afd9-046c382875a3}" />
    <Folder Name="I_TestDetailSink" Id="{5d21b229-ef9a-4d03-acc0-a356ac5bc052}" />
    <Folder Name="I_TestReporter" Id="{be220c5f-8658-4585-8c6e-4d252c191175}" />
    <Property Name="CheckCalls" Id="{93ef746d-acdd-4e1a-9046-f396892e9d9c}">
      <Declaration><![CDATA[PROPERTY CheckCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{bb5cba73-8858-4472-b504-a1ef896bee4a}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CheckCalls := _CheckCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CheckFailed" Id="{62e07e2d-184e-4b9c-9b11-29a534c45f39}" FolderPath="I_TestDetailSink\">
      <Declaration><![CDATA[METHOD CheckFailed
VAR_INPUT
	StepLabel  : T_MaxString;
	Kind	   : E_FailureKind;
	Expected   : T_MaxString;
	Actual	   : T_MaxString;
	Diagnostic : T_MaxString;
	Message	   : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CheckCalls		 := _CheckCalls + 1;
_CheckFailedCalls := _CheckFailedCalls + 1;
_LastExpected	 := Expected;
_LastActual		 := Actual;]]></ST>
      </Implementation>
    </Method>
    <Property Name="CheckFailedCalls" Id="{1762dc93-df2e-4458-8311-8e1a9bc5c4c7}">
      <Declaration><![CDATA[PROPERTY CheckFailedCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{3103d872-a900-4425-be32-af82f48da6a6}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CheckFailedCalls := _CheckFailedCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CheckPassed" Id="{d11ea80a-66d0-41b8-a567-30d8f39fe4c3}" FolderPath="I_TestDetailSink\">
      <Declaration><![CDATA[METHOD CheckPassed
VAR_INPUT
	StepLabel : T_MaxString;
	Detail	  : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CheckCalls		 := _CheckCalls + 1;
_CheckPassedCalls := _CheckPassedCalls + 1;]]></ST>
      </Implementation>
    </Method>
    <Property Name="CheckPassedCalls" Id="{20511a7b-ea15-4a47-8f44-09121317eaef}">
      <Declaration><![CDATA[PROPERTY CheckPassedCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{040e9ad7-e4bf-4baa-9302-d905933a3604}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CheckPassedCalls := _CheckPassedCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="Configure" Id="{738a2864-5aeb-4dcb-b9a5-148f384aebb4}">
      <Declaration><![CDATA[// Identify this spy and give it somewhere to record the order it was called in.
METHOD Configure
VAR_INPUT
	Ordinal : UDINT;
	Witness : I_ProbeWitness;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Ordinal := Ordinal;
_Witness := Witness;]]></ST>
      </Implementation>
    </Method>
    <Property Name="CyclicCalls" Id="{ac3f5811-986b-48b2-b40a-d06a3fd7dc45}">
      <Declaration><![CDATA[PROPERTY CyclicCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{b3f8e21a-d5af-4d54-99ec-089aa73656ef}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[CyclicCalls := _CyclicCalls;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="CyclicLogic" Id="{c78a4aca-f838-4ce1-9180-6278aba820d0}" FolderPath="I_Cyclic\">
      <Declaration><![CDATA[METHOD CyclicLogic]]></Declaration>
      <Implementation>
        <ST><![CDATA[_CyclicCalls := _CyclicCalls + 1;]]></ST>
      </Implementation>
    </Method>
    <Method Name="FrameworkError" Id="{e7405015-f51b-4d29-a3cf-fcf31d55d0e5}" FolderPath="I_TestReporter\">
      <Declaration><![CDATA[METHOD FrameworkError
VAR_INPUT
	Source	: T_MaxString;
	Message : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_FrameworkErrorCalls := _FrameworkErrorCalls + 1;
_LastErrorSource	 := Source;
_LastErrorMessage	 := Message;]]></ST>
      </Implementation>
    </Method>
    <Property Name="FrameworkErrorCalls" Id="{64cf5387-a0fa-4f47-9dd1-83a752f1cb08}">
      <Declaration><![CDATA[PROPERTY FrameworkErrorCalls : UDINT]]></Declaration>
      <Get Name="Get" Id="{bdb7cc24-b13f-4c4e-887c-5b487766d8ed}">
