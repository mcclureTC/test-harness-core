    <Method Name="PublishTest" Id="{a0ab878e-2ee1-4316-a9b4-83eabc3fe1ce}">
      <Declaration><![CDATA[// One test reached a terminal state. Fold it into the totals and tell the sinks.
METHOD PublishTest
VAR
	Journal : REFERENCE TO TestJournal;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _IsSingle THEN
	// Records nothing. The verdict is visible in the journal for whoever is at the
	// keyboard; it does not reach the counts or the sinks.
	RETURN;
END_IF

Journal REF= _LastJournal;

IF NOT __ISVALIDREF(Journal) THEN
	RETURN;
END_IF

_Tally.Record(Verdict := Journal.Status, ElapsedTime := Journal.ElapsedTime);

_Reporters.TestFinished(
	SuiteLabel	  := _Label,
	TestLabel	  := Journal.Label,
	Location	  := Journal.Location,
	Status		  := Journal.Status,
	Kind		  := Journal.Kind,
	Summary		  := Journal.Summary,
	ElapsedTime	  := Journal.ElapsedTime,
	ElapsedCycles := Journal.ElapsedCycles,
	Assertions	  := Journal.AssertionCount);]]></ST>
      </Implementation>
    </Method>
    <Method Name="RaiseFrameworkError" Id="{853be5de-8d56-4ff4-8da3-fb47cc0c0259}">
      <Declaration><![CDATA[// One place framework errors are named, so every one of them carries this suite's
// label as its source.
METHOD RaiseFrameworkError
VAR_INPUT
	Message : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _IsSingle THEN
	// An individual re-run is a debugging session, not a result. Its problems are
	// visible at the keyboard and must not turn a CI run red.
	RETURN;
END_IF

IF _IsRunning THEN
	_Tally.RecordFrameworkError();
ELSE
	// Held until there is a run to attribute it to.
	_PendingErrors := _PendingErrors + 1;
END_IF

_Reporters.FrameworkError(Source := _Label, Message := Message);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Register" Id="{f5741316-8794-4432-af24-78cbfe50a1b5}" FolderPath="I_TestRegistration\">
      <Declaration><![CDATA[METHOD Register : BOOL
VAR_INPUT
	Test	: I_Test;
	Label	: T_MaxString;
	Budgets : ST_TestBudgets;
END_VAR

VAR
	Fault : E_RegistrationFault;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.EnsureWired();

Fault	 := _Registry.TryClaim(Test := Test, Label := Label, Budgets := Budgets);
Register := (Fault = E_RegistrationFault.None);

IF Register THEN
	RETURN;
END_IF

// Never silent. A test that failed to register would otherwise vanish from the
// results and CI would see fewer passes rather than a failure - precisely the
// regression hazard RegisteredCount exists to catch.
CASE Fault OF
E_RegistrationFault.Full:
	THIS^.RaiseFrameworkError(CONCAT('suite is full, rejected: ', Label));
E_RegistrationFault.DuplicateLabel:
	THIS^.RaiseFrameworkError(CONCAT('label already registered: ', Label));
E_RegistrationFault.EmptyLabel:
	THIS^.RaiseFrameworkError('a test was offered with no label');
E_RegistrationFault.NoTest:
	THIS^.RaiseFrameworkError(CONCAT('no test supplied for label: ', Label));
E_RegistrationFault.Closed:
	THIS^.RaiseFrameworkError(CONCAT('registration has closed, rejected: ', Label));
END_CASE]]></ST>
      </Implementation>
    </Method>
    <Property Name="RegisteredCount" Id="{1bf75843-3c48-4b28-a2e3-93ca7a5fd865}" FolderPath="I_TestRegistration\">
      <Declaration><![CDATA[PROPERTY RegisteredCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{9e9bf422-a4f9-4cf9-a071-ff3c099c9a79}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[RegisteredCount := _Registry.Count;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="ReporterCount" Id="{d98748a8-d272-48f0-a25c-15b911eef335}" FolderPath="I_TestConfiguration\">
      <Declaration><![CDATA[PROPERTY ReporterCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{97bd5966-d7c0-4ca4-9465-53573d881c0f}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ReporterCount := _Reporters.Count;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="ReRun" Id="{9879baec-8e77-47eb-8039-a871c6679755}" FolderPath="I_TestReRun\">
      <Declaration><![CDATA[METHOD ReRun]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _IsRunning THEN
	THIS^.RaiseFrameworkError('ReRun called while a run is in progress');
	RETURN;
END_IF

// The registered set is not redefined, only re-executed. The window stays shut.
_Registry.ResetAll();
THIS^.StartRun();]]></ST>
      </Implementation>
    </Method>
    <Method Name="ReRunSingle" Id="{69e098da-80fb-495b-8499-d8694381cd8c}" FolderPath="I_TestReRun\">
      <Declaration><![CDATA[METHOD ReRunSingle : BOOL
VAR_INPUT
	Label : T_MaxString;
END_VAR

VAR
	Index	: DINT;
	Slot	: ST_TestSlot;
	Journal : REFERENCE TO TestJournal;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.EnsureWired();

ReRunSingle := FALSE;

IF _IsRunning THEN
	// Not while the suite is running. Two tests writing the same fixtures is the
	// interference serial execution exists to prevent.
	RETURN;
END_IF

Index := _Registry.Lookup(Label);

IF Index < 0 THEN
	RETURN;
END_IF

Journal REF= _Registry.Journal(Index);

IF NOT __ISVALIDREF(Journal) THEN
	RETURN;
END_IF

Slot := _Registry.Slot(Index);

// Records nothing and saves nothing. Silencing the fan-out is the whole
// mechanism: a session at the keyboard cannot pollute the CI artifact with
// duplicate entries, and no condition has to be threaded through the runner.
_Reporters.Suspend();

Journal.Reset();

IF NOT _Runner.Load(Slot) THEN
	_Reporters.Resume();
	RETURN;
END_IF

_LastJournal REF= Journal;
_IsSingle	:= TRUE;
_IsRunning	:= TRUE;
ReRunSingle := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Run" Id="{efe3e9db-28cd-4677-a15c-91e84a39194b}" FolderPath="I_TestExecution\">
      <Declaration><![CDATA[METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
END_VAR

VAR
	Slot	: ST_TestSlot;
	Outcome : E_PhaseOutcome;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.EnsureWired();

// Sinks advance whatever the suite is doing. A file write started at the end of
// the last run still has to finish, and a suite that has completed must keep
// pumping them or IsIdle never goes TRUE.
_Reporters.CyclicLogic();

Run := _Tally.IsComplete;

IF NOT Enable THEN
	IF _IsRunning THEN
		_Runner.Advance(Enable := FALSE);
		_Arbiter.Abandon();
		THIS^.FinishRun();
		Run := _Tally.IsComplete;
	END_IF
	RETURN;
END_IF

IF _Registry.IsOpen THEN
	THIS^.StartRun();
END_IF

IF NOT _IsRunning THEN
	RETURN;
END_IF

Outcome := _Runner.Advance(Enable := TRUE);

CASE Outcome OF

E_PhaseOutcome.Running:
	RETURN;

E_PhaseOutcome.TeardownOverran:
	// The verdict stands - a passing test whose cleanup hung still proved the code
	// correct - but the run cannot be trusted, and on a rig this may mean an axis
	// left powered.
	THIS^.RaiseFrameworkError(CONCAT(CONCAT('teardown abandoned in ', _Runner.ActiveLabel),
									 CONCAT(': ', _Runner.TeardownDiagnostic)));
	THIS^.PublishTest();

E_PhaseOutcome.Finished:
	THIS^.PublishTest();

END_CASE

IF _IsSingle THEN
	// One test, done. Nothing was recorded and nothing was saved, so there is
	// nothing to settle - just put the sinks back.
	_IsSingle  := FALSE;
	_IsRunning := FALSE;
	_Reporters.Resume();
	Run := _Tally.IsComplete;
	RETURN;
END_IF

// Idle, or just finished one. Take the next.
IF _Arbiter.Advance() THEN
	Slot := _Arbiter.Current;
	IF NOT _Runner.Load(Slot) THEN
		// The arbiter offered something the runner would not take. Report it rather
		// than spinning on it.
		THIS^.RaiseFrameworkError(CONCAT('could not start test: ', Slot.Label));
		_Arbiter.Abandon();
		THIS^.FinishRun();
	ELSE
		// Held so PublishTest can read the record after the runner has unloaded.
		_LastJournal REF= _Registry.Journal(Slot.Index);
		_ActiveLocation := '';
		IF __ISVALIDREF(_LastJournal) THEN
			_ActiveLocation := _LastJournal.Location;
		END_IF

		_Reporters.TestStarted(SuiteLabel := _Label,
							   TestLabel  := Slot.Label,
							   Location	  := _ActiveLocation);
	END_IF
ELSIF _Arbiter.IsExhausted THEN
	THIS^.FinishRun();
END_IF

Run := _Tally.IsComplete;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetDefaults" Id="{7093f627-cd86-43b7-ae76-4dcebc51b353}" FolderPath="I_TestDefaults\">
      <Declaration><![CDATA[METHOD SetDefaults
VAR_INPUT
	Defaults : ST_TestBudgets;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Stored, not applied. They reach the journals when the run starts, because a
// default may be set after some tests are already registered.
_Defaults := Defaults;]]></ST>
      </Implementation>
    </Method>
    <Method Name="SetLabel" Id="{c74c736e-0694-48e1-b138-75ce17f7a978}" FolderPath="I_TestConfiguration\">
      <Declaration><![CDATA[METHOD SetLabel
VAR_INPUT
	Label : T_MaxString;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Label := Label;
_Tally.SetLabel(Label);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Skip" Id="{d6891dda-456f-42b7-9aa5-5bd5fa8c4e00}" FolderPath="I_TestExecution\">
      <Declaration><![CDATA[METHOD Skip
VAR
	i		: DINT;
	Journal : REFERENCE TO TestJournal;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[THIS^.EnsureWired();

IF NOT _Registry.IsOpen THEN
	// Already enabled or already complete. Skipping now would rewrite results that
	// have been reported.
	THIS^.RaiseFrameworkError('Skip called after the suite was enabled');
	RETURN;
END_IF

// Closes the window. A skipped suite is complete, and registration does not
// reopen for a suite that has reached a terminal state.
_Registry.Close();
_Tally.Begin(_Registry.Count);

FOR i := 0 TO TO_DINT(_Registry.Count) - 1 DO
	Journal REF= _Registry.Journal(i);
	IF __ISVALIDREF(Journal) THEN
		Journal.MarkSkipped();
		_Tally.Record(Verdict := E_TestStatus.Skipped, ElapsedTime := 0.0);
	END_IF
END_FOR

_Tally.Finish();
_Reporters.SuiteFinished(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Property Name="SkippedCount" Id="{98cde481-38b7-493d-b0ca-c185c5e2ec01}" FolderPath="I_TestRunStatus\">
      <Declaration><![CDATA[PROPERTY SkippedCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{9b1d0d8e-128a-4766-bbf5-c1c090d26163}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[SkippedCount := _Tally.SkippedCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="StartRun" Id="{d46f3912-a93b-45f7-a65d-d04fb8d5cf98}">
      <Declaration><![CDATA[// First enable, or a re-run. Closes the window, pushes the defaults into every
// journal, and starts the pass.
METHOD StartRun
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Registry.Close();
_Registry.ApplyDefaults(_Defaults);

IF _Label = '' THEN
	// An unnamed suite produces an unnamed node in the result document, which no
	// CI system can group by.
	THIS^.RaiseFrameworkError('suite was enabled with no label');
END_IF

_Tally.Begin(_Registry.Count);

// Re-apply anything raised before the run existed, so a rejected registration
// still turns this run red.
FOR i := 1 TO TO_DINT(_PendingErrors) DO
	_Tally.RecordFrameworkError();
END_FOR

_Arbiter.Begin();
_IsRunning := TRUE;]]></ST>
      </Implementation>
    </Method>
    <Property Name="TestCount" Id="{7f49f3cb-6218-4fd7-83a1-20c5a2d3b231}" FolderPath="I_TestRunStatus\">
      <Declaration><![CDATA[PROPERTY TestCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{19e24700-160d-4cf9-85c3-1cd10fa842e0}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TestCount := _Tally.TestCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="TotalDuration" Id="{a32344ab-1156-4518-941d-67489124735c}" FolderPath="I_TestRunStatus\">
      <Declaration><![CDATA[PROPERTY TotalDuration : LREAL]]></Declaration>
      <Get Name="Get" Id="{73638bd9-d62a-4136-8884-5b0baf69b309}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[TotalDuration := _Tally.TotalDuration;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>