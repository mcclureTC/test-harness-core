      </Get>
    </Property>
    <Property Name="Label" Id="{1473a791-d77c-44e4-9a4a-43e67afe194b}" FolderPath="I_Labelled\">
      <Declaration><![CDATA[PROPERTY Label : T_MaxString]]></Declaration>
      <Get Name="Get" Id="{6a7e9786-ca65-426a-bf36-636c19baf8c8}">
