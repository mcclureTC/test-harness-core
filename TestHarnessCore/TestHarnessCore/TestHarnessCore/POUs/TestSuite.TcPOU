<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TestSuite" Id="{b07633b0-8158-4191-b934-913c367328cb}" SpecialFunc="None">
    <Declaration><![CDATA[// The composition root's handle on a set of tests, and the sequencer's handle on
// running them. Six interfaces, four audiences, one object.
//
// It is a FACADE and should stay one. Registration lives in TestRegistry,
// ordering in TestArbiter, the test lifecycle in TestRunner, the counts in
// TestRunTally, the sinks in TestReporterFanout. What is left here is the
// registration window, the per-scan order of operations, and naming a framework
// error - and if this object grows past that, something belongs in one of the
// five.
//
// One object doing all six jobs is most of why such a thing becomes
// being replaced.
//
// GENERIC only because it declares TestRegistry<Capacity> as a member and only a
// generic can forward the argument. Nothing here is sized by Capacity. Everything
// else it owns is plain, and reaches the registry through interfaces this object
// hands out.
FUNCTION_BLOCK TestSuite
VAR_GENERIC CONSTANT
	Capacity : UDINT := TestHarnessParameter.Capacity;
END_VAR IMPLEMENTS I_TestRegistration, I_TestDefaults, I_TestConfiguration, I_TestSuite, I_TestReRun
VAR
	_Registry  : TestRegistry<Capacity>;
	_Arbiter   : TestArbiter;
	_Runner	   : TestRunner;
	_Tally	   : TestRunTally;
	_Reporters : TestReporterFanout;

	// ONE per suite, not one per test. Only one test runs at a time, so the handle
	// is retargeted to whichever journal is active rather than allocated per slot.
	// At capacity 50 that is the difference between one copy of the assertion
	// machinery and fifty.
	_Verdict : TestVerdict;

	_Label	  : T_MaxString;
	_Defaults : ST_TestBudgets;

	_IsRunning : BOOL;
	_IsWired   : BOOL;

	// An individual re-run is in progress: one test, reported nowhere and counted
	// nowhere. The arbiter is not involved and the tally is not touched.
	_IsSingle : BOOL;

	// Framework errors raised BEFORE the run started - a rejected registration, an
	// unnamed suite. Tally.Begin clears its counts, so these are held and re-applied
	// once the run exists. Without that, a test that failed to register would leave
	// the run green, which is the exact regression hazard the reporting exists for.
	_PendingErrors : UDINT;

	// The journal of the test that just finished, held so PublishTest can read it
	// after the runner has unloaded.
	_LastJournal	: REFERENCE TO TestJournal;
	_ActiveLocation : T_MaxString;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
	No cyclic body, deliberately. This object is reached through its interfaces -
	Register, Run, Skip - and a sequencer holding I_TestSuite has no way to call the
	function block itself. Wiring that depended on this running would silently never
	happen.

	EnsureWired is called from every entry point instead.
*)]]></ST>
    </Implementation>
    <Folder Name="I_Labelled" Id="{32e30b35-705e-4045-91ac-98d4e59219d4}" />
    <Folder Name="I_TestConfiguration" Id="{e849ddaf-c62c-4d58-a4c0-30bb790ff535}" />
    <Folder Name="I_TestDefaults" Id="{38fb1a35-d5ce-4af3-bf12-f343d4e13f99}" />
    <Folder Name="I_TestExecution" Id="{9d7e0ae2-a8da-49d8-874b-9983ce649228}" />
    <Folder Name="I_TestRegistration" Id="{89da61b1-998f-4ec2-bc93-851701c7a10d}" />
    <Folder Name="I_TestReRun" Id="{aa7a75d5-d87d-41eb-bc48-c32e94c4b326}" />
    <Folder Name="I_TestRunStatus" Id="{e7aae5b4-7503-4862-9f14-220c1487b1b3}" />
    <Method Name="AddReporter" Id="{baa79725-0ccb-4a1d-a164-743f22612f9a}" FolderPath="I_TestConfiguration\">
      <Declaration><![CDATA[METHOD AddReporter : BOOL
VAR_INPUT
	Reporter : I_TestReporter;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[AddReporter := _Reporters.Attach(Reporter);]]></ST>
      </Implementation>
    </Method>
    <Method Name="EnsureWired" Id="{c191e45e-2a3e-4733-8621-de50ed48fcf0}">
      <Declaration><![CDATA[// Hand the five collaborators to each other. Once, on first use.
//
// Not FB_init: the members are not all constructed when it runs. Not the cyclic
// body: this object is driven through its interfaces and the function block itself
// may never be called.
METHOD EnsureWired]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF _IsWired THEN
	RETURN;
END_IF

_IsWired := TRUE;

_Verdict.AttachDetailSink(_Reporters);
_Runner.Attach(Roster := _Registry, Verdict := _Verdict);
_Arbiter.Attach(_Registry);]]></ST>
      </Implementation>
    </Method>
    <Property Name="ErrorCount" Id="{0b6c4d37-d12b-43bf-b0f9-363f3049a18a}" FolderPath="I_TestRunStatus\">
      <Declaration><![CDATA[PROPERTY ErrorCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{cbd749cf-bbe9-4537-8645-53d3275e7765}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[ErrorCount := _Tally.ErrorCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="FailedCount" Id="{9f7a22e6-b260-465d-86f3-6b628fc1951a}" FolderPath="I_TestRunStatus\">
      <Declaration><![CDATA[PROPERTY FailedCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{8df06e9d-9cf0-43fe-b647-3ce06ff424c7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[FailedCount := _Tally.FailedCount;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Method Name="FinishRun" Id="{eeab7f99-5041-4334-b8aa-1cd81111659b}">
      <Declaration><![CDATA[// The pass is over, cleanly or by abandonment. Settles the aggregate and tells
// the sinks once.
METHOD FinishRun]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _IsRunning THEN
	RETURN;
END_IF

_IsRunning := FALSE;
_Tally.Finish();
_Reporters.SuiteFinished(THIS^);]]></ST>
      </Implementation>
    </Method>
    <Property Name="IsComplete" Id="{ac1fb95d-ad9c-40c1-9e73-d35ee73170a0}" FolderPath="I_TestRunStatus\">
