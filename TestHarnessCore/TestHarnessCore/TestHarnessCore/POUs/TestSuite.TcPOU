      <Get Name="Get" Id="{5f7b87ee-2f4d-448b-a2fb-a374afc9c6e7}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsComplete := _Tally.IsComplete;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsOpen" Id="{da9e09cf-7149-4bfc-8ddf-f4af89091d38}" FolderPath="I_TestRegistration\">
