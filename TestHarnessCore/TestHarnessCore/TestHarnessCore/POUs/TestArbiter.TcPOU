<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TestArbiter" Id="{44f0cafe-1fd7-4ed6-8016-777559cd7754}" SpecialFunc="None">
    <Declaration><![CDATA[// Which test runs next, and when there are no more.

//

// Separated from the runner because it is the ordering POLICY and the runner is

// the test LIFECYCLE - two different reasons to change. Everything a sequencer

// parks for later lands here and nowhere else: stop on first failing test, retry,

// preconditions. Today it walks the set in registration order, and that is all it

// should do.

//

// Not generic, and holds nothing generic. It reaches the registered set through

// I_TestRoster, which is read-only: an object that decides what runs next has no

// business registering a test or clearing a verdict.
FUNCTION_BLOCK TestArbiter
VAR
	_Roster : I_TestRoster;

	// The active test. A null Test member means none - there is no sentinel index.
	_Current : ST_TestSlot;
	_Count	 : DINT;

	// Where the NEXT Advance will look. Not the active index: that lives on

	// _Current, which is the only place it is meaningful.
	_Next : DINT;

	// Never written. Assigned to _Current to clear it, so "nothing active" is one

	// well-defined value rather than six field assignments to keep in step.
	_EmptySlot : ST_TestSlot;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
	No cyclic body. Advance is called by the suite when the active test finishes,
	not every scan.
*)]]></ST>
    </Implementation>
    <Method Name="Abandon" Id="{2114e7dc-8cf2-4aa2-aa8b-972cf23a79fd}">
      <Declaration><![CDATA[// Stop the pass where it is. Called when Enable drops: the active test, and any

// setup or teardown in flight, are cancelled by the runner and the pass does not

// resume.

//

// The remaining tests are NOT visited. A run that was abandoned mid-way has not

// been run, and reporting the rest as anything - passed, failed, skipped - would

// be inventing a result.
METHOD Abandon]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Current := _EmptySlot;
_Next	 := _Count;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Advance" Id="{e3216687-a3bc-4ec3-a10e-09ddb8e380ce}">
      <Declaration><![CDATA[// Move to the next test. Returns TRUE when there is one, FALSE when the pass is

// over.

//

// The return value is the whole "are we finished" mechanism, so a caller cannot

// reach a test without first having been told there is one.
METHOD Advance : BOOL]]></Declaration>
      <Implementation>
        <ST><![CDATA[Advance	 := FALSE;
_Current := _EmptySlot;
IF (_Roster = 0) OR (_Next >= _Count) THEN
	_Next := _Count;
	RETURN;
END_IF

_Current := _Roster.Slot(_Next);
_Next	 := _Next + 1;

// A slot inside the registered range always carries a test. If one does not, the

// registry and the count disagree, and running nothing is safer than dereferencing

// a null.
Advance := (_Current.Test <> 0);]]></ST>
      </Implementation>
    </Method>
    <Method Name="Attach" Id="{9048cedf-3df1-4167-bc4d-bec4487a9daf}">
      <Declaration><![CDATA[// Point the arbiter at the registered set. Called once by the suite at

// composition, before any run.

//

// An interface, not the registry itself: TestRegistry is generic and cannot be

// held by its concrete type here. That constraint turned out to be the thing that

// is what makes that workable - an interface reference carries no

// generic argument, so the arbiter can hold the set AND stay non-generic.
METHOD Attach
VAR_INPUT
	Roster : I_TestRoster;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Roster := Roster;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Begin" Id="{1768a50f-c1b8-4247-b2f6-014860b23ec9}">
      <Declaration><![CDATA[// Start a pass over the registered set, in registration order.

//

// Also what a re-run calls: a re-run re-executes the registered set from the

// start, so there is no separate restart path to keep in step with this one.

//

// The count is read here, once, rather than per Advance. Registration is closed by

// the time a run starts, so it cannot change underneath the pass.
METHOD Begin]]></Declaration>
      <Implementation>
        <ST><![CDATA[_Current := _EmptySlot;
_Next	 := 0;
IF _Roster = 0 THEN
	// Nothing attached. An empty pass rather than a fault: IsExhausted goes TRUE

	// immediately and the suite completes instead of waiting for a test that will
	// never come.
	_Count := 0;
	RETURN;
END_IF

_Count := TO_DINT(_Roster.Count);]]></ST>
      </Implementation>
    </Method>
    <Property Name="Current" Id="{2d7b5d99-f957-492e-83a6-c4c92f7734ce}">
      <Declaration><![CDATA[// The active test, with its label, its index and its resolved hooks. Its Test

// member is NULL when nothing is active, which is the question callers ask.

//

// "None" is a null reference, not a sentinel

// index. The index is still here - a slot carries its own position, so the runner

// can reach the matching journal - but it is carried BY the thing that is null

// when there is nothing, rather than standing in for it.
PROPERTY Current : ST_TestSlot]]></Declaration>
      <Get Name="Get" Id="{a225fa31-adb0-4d61-a706-f09443b84866}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[Current := _Current;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="HasCurrent" Id="{98eb553e-3ad2-4b1c-8802-cdab4b934084}">
      <Declaration><![CDATA[// TRUE while a test is active.

//

// Letting index 0 double as "no active test" is the trap here, and the note

// why that could not work is what CHAR_SerialExecution pins. Here there is no

// index to misread: the question is whether a reference is null.
PROPERTY HasCurrent : BOOL]]></Declaration>
      <Get Name="Get" Id="{b82d3b5d-1156-4dbf-9a5d-329c22aeb676}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[HasCurrent := (_Current.Test <> 0);]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsExhausted" Id="{eb9f2487-fa1a-4a01-98b4-1af25c285df9}">
      <Declaration><![CDATA[// Every registered test has been visited, or the pass was abandoned. What the

// suite reads to decide the run is over.

//

// Both conditions are required. After the last test is selected the pass has

// nothing left to give out, but that test is still running - reporting the suite

// complete there would cut it off.

//

// TRUE immediately for a pass over an empty set: a suite with nothing registered

// is complete, not stuck, or any sequencer aggregating it waits forever.
PROPERTY IsExhausted : BOOL]]></Declaration>
      <Get Name="Get" Id="{60215939-eed7-43fb-8c4b-4e306289d147}">
        <Declaration><![CDATA[VAR
END_VAR]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsExhausted := (_Next >= _Count) AND (_Current.Test = 0);]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>