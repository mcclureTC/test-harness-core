<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <POU Name="TestRegistry" Id="{b3416392-9d7c-4358-9455-afb1778de422}" SpecialFunc="None">
    <Declaration><![CDATA[// The registered set: which tests, in what order, under what labels, with their
// journals.
//
// It exists so the capacity bound lives in ONE place. The original expressed the
// same bound as a loop limit in four, and a version existed where ReRunTests
// looped to a parameter while the array was sized by the generic - so a smaller
// instance wrote past the end of its own array. Overflow here is "no free slot
// found", never an index compared against a maximum.
//
// ARRAY[0..Capacity - 1] holds exactly Capacity tests. The original declared
// ARRAY[0.._MaxTestCount], giving N+1, which the README had to explain and which
// leaked into a diagnostic that was simply false.
//
// Capacity must be at least 1. ARRAY[0..-1] is a compile error and that is the
// right outcome - clamping a zero to one slot would be the same class of silent
// surprise this library exists to remove.
//
// THE ONLY GENERIC OBJECT that consumers touch, and the reason every one of them
// touches it through an interface: a generic instance cannot be passed by its
// concrete type, even to something declaring that same type from the same scope.
// Three faces, three audiences - the suite writes, the arbiter and runner read,
// the suite alone resets. See Plan.md 2.2 and 4.6.
FUNCTION_BLOCK TestRegistry
VAR_GENERIC CONSTANT
	Capacity : UDINT := TestHarnessParameter.Capacity;
END_VAR IMPLEMENTS I_TestRegistrar, I_TestRoster, I_TestJournalSet
VAR
	_Slots	  : ARRAY[0..Capacity - 1] OF ST_TestSlot;
	// One per slot, sized by the same bound. Separate from ST_TestSlot because a
	// journal is a function block with methods, and the slot is a value.
	_Journals : ARRAY[0..Capacity - 1] OF TestJournal;
	_Count	  : UDINT;
	_IsOpen	  : BOOL := TRUE;
	// Never written. Returned for an out-of-range index so the caller gets a
	// well-defined empty slot rather than whatever was nearby.
	_EmptySlot : ST_TestSlot;
END_VAR]]></Declaration>
    <Implementation>
      <ST><![CDATA[(*
	No cyclic body. The registry is written at startup and read while the run is in
	progress; nothing here has per-scan work.
*)]]></ST>
    </Implementation>
    <Folder Name="I_TestJournalSet" Id="{28c5c4f1-991c-4314-b9c9-637f49341143}" />
    <Folder Name="I_TestRegistrar" Id="{f6bc7b2c-83bf-42df-9dec-70abf1da05a0}" />
    <Folder Name="I_TestRoster" Id="{94689059-8ccc-46c1-b9c4-9d8935c66db2}" />
    <Method Name="TryClaim" Id="{47c12183-db3e-4dc6-a5ea-96f1197d7a7a}" FolderPath="I_TestRegistrar\">
      <Declaration><![CDATA[METHOD TryClaim : E_RegistrationFault
VAR_INPUT
	Test	: I_Test;
	Label	: T_MaxString;
	Budgets : ST_TestBudgets;
END_VAR

VAR
	Index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[IF NOT _IsOpen THEN
	TryClaim := E_RegistrationFault.Closed;
	RETURN;
END_IF

IF Test = 0 THEN
	TryClaim := E_RegistrationFault.NoTest;
	RETURN;
END_IF

IF Label = '' THEN
	TryClaim := E_RegistrationFault.EmptyLabel;
	RETURN;
END_IF

IF THIS^.Lookup(Label) >= 0 THEN
	TryClaim := E_RegistrationFault.DuplicateLabel;
	RETURN;
END_IF

IF _Count >= Capacity THEN
	TryClaim := E_RegistrationFault.Full;
	RETURN;
END_IF

Index := TO_DINT(_Count);

_Slots[Index].Test	:= Test;
_Slots[Index].Index := Index;
_Slots[Index].Label := Label;

// Resolved once. A hook the test does not implement stays null, and null is the
// whole mechanism - there is nothing for a test author to opt out of.
IF NOT __QUERYINTERFACE(Test, _Slots[Index].Setup) THEN
	_Slots[Index].Setup := 0;
END_IF
IF NOT __QUERYINTERFACE(Test, _Slots[Index].Teardown) THEN
	_Slots[Index].Teardown := 0;
END_IF
IF NOT __QUERYINTERFACE(Test, _Slots[Index].Location) THEN
	_Slots[Index].Location := 0;
END_IF

_Journals[Index].SetBudgets(Budgets);

_Count	 := _Count + 1;
TryClaim := E_RegistrationFault.None;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Close" Id="{c65a4966-12ec-4b1f-8131-ca8f51710885}" FolderPath="I_TestRegistrar\">
      <Declaration><![CDATA[METHOD Close]]></Declaration>
      <Implementation>
        <ST><![CDATA[_IsOpen := FALSE;]]></ST>
      </Implementation>
    </Method>
    <Method Name="Lookup" Id="{c1b6fdfe-0f8f-42ba-a226-6289086661b6}" FolderPath="I_TestRoster\">
      <Declaration><![CDATA[METHOD Lookup : DINT
VAR_INPUT
	Label : T_MaxString;
END_VAR

VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[Lookup := -1;

IF Label = '' THEN
	RETURN;
END_IF

// Linear, and deliberately so: it runs at registration and on an individual
// re-run, never per scan, and a sorted structure would cost ordering - which IS
// the execution order.
FOR i := 0 TO TO_DINT(_Count) - 1 DO
	IF _Slots[i].Label = Label THEN
		Lookup := i;
		RETURN;
	END_IF
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="Slot" Id="{18f90229-53c2-4846-8118-d751e478d623}" FolderPath="I_TestRoster\">
      <Declaration><![CDATA[METHOD Slot : ST_TestSlot
VAR_INPUT
	Index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// An out-of-range index yields the empty slot: a null Test and an Index of -1.
Slot := _EmptySlot;

IF (Index < 0) OR (Index >= TO_DINT(_Count)) THEN
	RETURN;
END_IF

Slot := _Slots[Index];]]></ST>
      </Implementation>
    </Method>
    <Method Name="Journal" Id="{08f644e4-1b45-4f7b-b5d1-c159b3a1c2ec}" FolderPath="I_TestRoster\">
      <Declaration><![CDATA[METHOD Journal : REFERENCE TO TestJournal
VAR_INPUT
	Index : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[// Invalidated first. A method returning REFERENCE TO that simply returns leaves
// the reference undefined, and undefined reads as valid often enough to pass by
// luck rather than by design.
Journal REF= 0;

IF (Index < 0) OR (Index >= TO_DINT(_Count)) THEN
	RETURN;
END_IF

Journal REF= _Journals[Index];]]></ST>
      </Implementation>
    </Method>
    <Method Name="ApplyDefaults" Id="{9733ec81-1670-497c-932b-5174081963ef}" FolderPath="I_TestJournalSet\">
      <Declaration><![CDATA[METHOD ApplyDefaults
VAR_INPUT
	Defaults : ST_TestBudgets;
END_VAR

VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO TO_DINT(_Count) - 1 DO
	_Journals[i].ApplyDefaults(Defaults);
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Method Name="ResetAll" Id="{4ef9c8b2-73a4-41a8-98d9-e50631216abe}" FolderPath="I_TestJournalSet\">
      <Declaration><![CDATA[METHOD ResetAll
VAR
	i : DINT;
END_VAR]]></Declaration>
      <Implementation>
        <ST><![CDATA[FOR i := 0 TO TO_DINT(_Count) - 1 DO
	_Journals[i].Reset();
END_FOR]]></ST>
      </Implementation>
    </Method>
    <Property Name="Count" Id="{a4568747-8d76-449a-b92a-35a5928f6d71}" FolderPath="I_TestRoster\">
      <Declaration><![CDATA[PROPERTY Count : UDINT]]></Declaration>
      <Get Name="Get" Id="{9a6366ea-e2ae-4d87-9c75-365237bfb0e8}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[Count := _Count;]]></ST>
        </Implementation>
      </Get>
    </Property>
    <Property Name="IsOpen" Id="{f1d85bb4-9be0-429c-b044-e18384e0bdc1}" FolderPath="I_TestRegistrar\">
      <Declaration><![CDATA[PROPERTY IsOpen : BOOL]]></Declaration>
      <Get Name="Get" Id="{ac2aeb00-ed5f-4526-bd0c-f021baa61f44}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
        <Implementation>
          <ST><![CDATA[IsOpen := _IsOpen;]]></ST>
        </Implementation>
      </Get>
    </Property>
  </POU>
</TcPlcObject>