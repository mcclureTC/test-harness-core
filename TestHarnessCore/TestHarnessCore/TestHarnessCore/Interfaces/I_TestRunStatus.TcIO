<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <Itf Name="I_TestRunStatus" Id="{c8fc3484-8a44-4188-ab19-c846b99d133b}">
    <Declaration><![CDATA[// The read model. Implemented by a suite, and by a sequencer aggregating suites -

// which is what makes sequencers nest and lets a consumer poll one symbol

// regardless of how many suites exist.

//

// Read-only, and separate from the driving surface on purpose: something that only

// wants to know whether the run finished should not also be handed the ability to

// restart it.

//

// Computing all of this every scan and exposing none of it is the trap. The counts

// were private and absent from any interface, so nothing could ask whether a run

// had finished - the only signals were a file appearing on disk and a line in a

// log, both of which have to be scraped.

//

// A flat struct carrying the same values is published alongside, so ADS, TwinCAT

// HMI and OPC UA read it as plain symbols without RPC. That is the portable path,

// and the one CI polls.
INTERFACE I_TestRunStatus EXTENDS I_Labelled]]></Declaration>
    <Property Name="ErrorCount" Id="{c138f240-399f-4f01-af72-fcc145dd94ba}">
      <Declaration><![CDATA[// Tests that could not run, plus framework errors. Kept apart from FailedCount

// because a build should react differently: a failure means the code is wrong, an

// error means the run cannot be trusted.
PROPERTY ErrorCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{9626a572-8a18-4b74-9afd-531c0ef18442}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
      </Get>
    </Property>
    <Property Name="FailedCount" Id="{7dee69bd-7c13-4d7f-b406-a9609c7fa41e}">
      <Declaration><![CDATA[// Checks that did not hold.
PROPERTY FailedCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{65626a81-4f23-4c04-98c0-70881c4c080d}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
      </Get>
    </Property>
    <Property Name="IsComplete" Id="{b4347bcd-2013-432d-8a4b-b20e2a29e5d6}">
      <Declaration><![CDATA[// Reached a terminal state - NOT 'ran everything'.

//

// A skipped suite reports complete. If it did not, any aggregate containing one

// would wait for it forever.
PROPERTY IsComplete : BOOL]]></Declaration>
      <Get Name="Get" Id="{95d0781c-b9c8-46e7-8b2a-7ca8e9460ec5}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
      </Get>
    </Property>
    <Property Name="Outcome" Id="{8892a887-c10e-4dd4-aced-f9ca9adacf43}">
      <Declaration><![CDATA[// Readable while the run is in progress, not only at the end: Outcome

// distinguishes Running from every terminal value.
PROPERTY Outcome : E_RunOutcome]]></Declaration>
      <Get Name="Get" Id="{9a60f19a-cd2d-4dd3-9413-4a7a171de037}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
      </Get>
    </Property>
    <Property Name="PassedCount" Id="{69cb7edf-3d83-4d32-bd39-0287b6d763c1}">
      <Declaration><![CDATA[PROPERTY PassedCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{ebd7237c-5d78-4882-905c-9a524f8edc96}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
      </Get>
    </Property>
    <Property Name="SkippedCount" Id="{91317776-f74d-4eba-965d-91662da5b08a}">
      <Declaration><![CDATA[// Not a failure. Must not turn a build red.
PROPERTY SkippedCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{8bd1b763-6c91-4f0f-b5b5-c84271286fbd}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
      </Get>
    </Property>
    <Property Name="TestCount" Id="{7ebbfb87-7093-4afa-85db-5d48e51aef1c}">
      <Declaration><![CDATA[// Tests registered. Once complete, Passed + Failed + Errored + Skipped equals it.
PROPERTY TestCount : UDINT]]></Declaration>
      <Get Name="Get" Id="{a2b6040a-8e34-495d-b50e-4e5a59663925}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
      </Get>
    </Property>
    <Property Name="TotalDuration" Id="{5b22496c-7227-498a-90d6-dbb9729e135c}">
      <Declaration><![CDATA[// Seconds for the whole run: a suite sums its tests, a sequencer sums its

// suites.

//

// Named apart from I_TestTiming.ElapsedTime deliberately. The two are not one

// concept declared twice - one is how long a single test has been going, the

// other an aggregate over many. Two interfaces declaring the same member is a

// design error even when the types match, and here the meanings differ too.
PROPERTY TotalDuration : LREAL]]></Declaration>
      <Get Name="Get" Id="{ee62fec0-dd92-4cf5-91aa-251665d4b065}">
        <Declaration><![CDATA[VAR
END_VAR
]]></Declaration>
      </Get>
    </Property>
  </Itf>
</TcPlcObject>