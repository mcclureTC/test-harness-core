<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="I_TestAssertions" Id="{7bb027b6-8da3-4bc9-b78c-49a33894074e}">
    <Declaration><![CDATA[// The handle a test body reports through: the verdict surface, the runner's
// timing, and the built-in comparisons.
//
// Handed to the test on every call. Never held, never stored.
//
// Everything here is a convenience over I_TestOutcome.RecordPass and
// RecordFailure. Domain helpers should take the narrower I_TestOutcome instead -
// they report, they do not need to compare.
//
// There is no WaitUntil. A test that is not finished returns FALSE from Run and is
// called again; waiting is the absence of returning TRUE.
INTERFACE I_TestAssertions EXTENDS I_TestOutcome, I_TestTiming]]></Declaration>
    <Method Name="AssertTrue" Id="{d6f49cce-33c6-472a-9384-4b43f6ccd911}">
      <Declaration><![CDATA[METHOD AssertTrue
VAR_INPUT
	Condition : BOOL;
	Message	  : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertFalse" Id="{9d0c85d7-c8e5-4baa-983e-49cee77ae83c}">
      <Declaration><![CDATA[METHOD AssertFalse
VAR_INPUT
	Condition : BOOL;
	Message	  : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertEqual" Id="{0ac6758f-e456-47b3-a37c-87690eb7dd05}">
      <Declaration><![CDATA[// Compares two values of the same type, including strings and enums.
//
// ANY binds only to an addressable variable. A literal, a property or an inlined
// constant will not compile, so both sides must be copied into variables first.
// A language constraint, not a choice.
METHOD AssertEqual
VAR_INPUT
	Expected : ANY;
	Actual	 : ANY;
	Message	 : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertNotEqual" Id="{ae452047-5c4b-4f68-9fe7-bc1813746713}">
      <Declaration><![CDATA[// See AssertEqual on the ANY constraint.
METHOD AssertNotEqual
VAR_INPUT
	Expected : ANY;
	Actual	 : ANY;
	Message	 : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertGreater" Id="{b4f67768-60cf-4a7b-94b7-15eb133edada}">
      <Declaration><![CDATA[// Actual > Bound. Numeric types only. See AssertEqual on the ANY constraint.
METHOD AssertGreater
VAR_INPUT
	Actual	: ANY;
	Bound	: ANY;
	Message : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertLess" Id="{6b0b7a51-3e32-4102-b76f-4f9b9c4e45a8}">
      <Declaration><![CDATA[// Actual < Bound. Numeric types only. See AssertEqual on the ANY constraint.
METHOD AssertLess
VAR_INPUT
	Actual	: ANY;
	Bound	: ANY;
	Message : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertNear" Id="{49dce46e-b3a7-4015-8688-14abdcf58b0c}">
      <Declaration><![CDATA[// ABSOLUTE tolerance: passes when |Expected - Actual| <= Tolerance.
//
// Tolerance carries the units of the value compared - millimetres, volts, counts.
// Its counterpart is AssertWithin, which takes a fraction instead.
//
// AssertEqual compares floats EXACTLY. Tolerance is never applied implicitly, so
// choosing it is visible at the call site.
METHOD AssertNear
VAR_INPUT
	Expected  : LREAL;
	Actual	  : LREAL;
	Tolerance : LREAL;
	Message	 : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertWithin" Id="{d1c6af21-5147-4452-8b91-2e50fd9ced51}">
      <Declaration><![CDATA[// RELATIVE tolerance: passes when |Expected - Actual| <= |Expected| * Fraction.
//
// Holds its meaning across magnitudes, which absolute tolerance does not. Near
// zero it collapses to exact equality - if zero is the expected value, use
// AssertNear.
METHOD AssertWithin
VAR_INPUT
	Expected : LREAL;
	Actual	 : LREAL;
	// Dimensionless. 0.001 is 0.1 per cent of Expected.
	Fraction : LREAL;
	Message	 : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertInRange" Id="{496acdbf-7f2e-45fa-b873-cbfe0c81b139}">
      <Declaration><![CDATA[// Inclusive on both bounds.
METHOD AssertInRange
VAR_INPUT
	Actual	: LREAL;
	Minimum : LREAL;
	Maximum : LREAL;
	Message : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertMemEqual" Id="{f881604a-d3f0-486e-9893-715cbbe3220b}">
      <Declaration><![CDATA[// Byte comparison of two regions of equal length. Reports the offset of the
// first difference.
METHOD AssertMemEqual
VAR_INPUT
	pExpected : POINTER TO BYTE;
	pActual	  : POINTER TO BYTE;
	Length	  : UDINT;
	Message	  : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertBufferEqual" Id="{3c5ce92c-b89a-41a6-8113-902661a22829}">
      <Declaration><![CDATA[// As AssertMemEqual, but lengths are compared first and a mismatch is reported
// as SizeMismatch rather than as a difference at some offset.
METHOD AssertBufferEqual
VAR_INPUT
	pExpected	   : POINTER TO BYTE;
	ExpectedLength : UDINT;
	pActual		   : POINTER TO BYTE;
	ActualLength   : UDINT;
	Message		   : T_MaxString;
END_VAR]]></Declaration>
    </Method>
    <Method Name="AssertCompletedWithin" Id="{74bead21-bb07-4bd9-aa9b-9fb92a49bef9}">
      <Declaration><![CDATA[// Asserts the test has not yet used more than Cycles scans. Built on
// I_TestTiming.ElapsedCycles, so it needs no bookkeeping from the test.
//
// Opt-in, never a default. A scan budget is a real regression signal on a fixed
// target and noise across a matrix of them.
METHOD AssertCompletedWithin
VAR_INPUT
	Cycles	: UDINT;
	Message : T_MaxString;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
