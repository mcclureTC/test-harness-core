<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1">
  <Itf Name="I_TestSetup" Id="{801db1ee-d024-43f8-a3f5-17427c23c39b}">
    <Declaration><![CDATA[// Optional. Implement when a test needs preparation that may span scans and is
// worth separating from the body.
//
// The suite calls Setup to completion before the first call to Run. A failure or
// error recorded during setup ends the test without running the body - which is
// the point: a test whose fixture never came up has not been exercised, and
// reporting it as a failed check would be a lie.
//
// I_TestTiming.IsFirstCycle covers anything simpler than this.
INTERFACE I_TestSetup EXTENDS __SYSTEM.IQueryInterface]]></Declaration>
    <Method Name="Setup" Id="{83cf441f-77e4-427d-8089-ea8e8c02afed}">
      <Declaration><![CDATA[// Return TRUE when setup is complete. Enable behaves as in I_Test.Run.
//
// Bounded by its own deadline, separate from the test's.
METHOD Setup : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>
