<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <Itf Name="I_Test" Id="{18aa7a29-c9ad-4a6d-b214-c87e5de2c245}">
    <Declaration><![CDATA[// A test. Implemented by test code you write - never by the code under test.

//

// One method is the entire framework contract for a test author.

//

// Reaches IQueryInterface so the suite can ask, at registration, whether a test

// also implements I_TestSetup, I_TestTeardown or I_TestLocation. Those three are

// optional and independent: implement none, one, or all, with no empty bodies for

// the ones you do not want. They do not share a base interface because they would

// have to share a method name, and a test implementing two would then collide.
INTERFACE I_Test EXTENDS __SYSTEM.IQueryInterface]]></Declaration>
    <Method Name="Run" Id="{d620dea7-4b85-49cf-9c5e-a379b165f97f}">
      <Declaration><![CDATA[// Called by the suite once per scan while this test is the active one, and never

// otherwise. There is no gate to check and no permission to ask: if you were

// called, run.

//

// Return TRUE when there is no more work. A single-scan test returns TRUE on its

// first call; a multi-scan test returns FALSE until its state machine finishes.

// The test declares completion - the framework never infers it from the checks,

// Without it a test can end at its first passing check and report

// green on work it never reached.

//

// Enable is held TRUE while the test should keep running. The suite drops it to

// abandon a test, on reset or re-run. On a falling edge the test returns its own

// state to its starting condition and returns TRUE; the value is otherwise

// ignored in that case.

//

// The verdict is not returned here. It is whatever the checks recorded through

// Test, and it belongs to the runner.
METHOD Run : BOOL
VAR_INPUT
	Enable : BOOL;
	Test   : I_TestAssertions;
END_VAR]]></Declaration>
    </Method>
  </Itf>
</TcPlcObject>