<?xml version="1.0" encoding="utf-8"?>
<TcPlcObject Version="1.1.0.1" ProductVersion="3.1.4026.18">
  <GVL Name="TestHarnessParameter" Id="{f09cf24a-7c72-4cbd-8442-379efd852d18}" ParameterList="True">
    <Declaration><![CDATA[// Dials a referencing project can turn from the Library Manager, without editing
// this library.
//
// Everything here is a DEFAULT, not a limit. Capacity is overridable per instance
// as well - TestRegistry<20> - so this is the value a declaration inherits when it
// says nothing.
{attribute 'qualified_only'}
VAR_GLOBAL CONSTANT
	// Tests a suite can hold. Every slot costs its journal whether used or not, so
	// prefer several small suites to one large one.
	//
	// Must be at least 1: ARRAY[0..Capacity - 1] with zero is a compile error, and
	// that is the right outcome. Clamping a zero to one slot would be the same class
	// of silent surprise this library exists to remove.
	Capacity		 : UDINT := 10;
	// Sinks a suite or sequencer can hold. Not a generic argument: a project
	// attaches the same set of sinks to every suite it owns, so per-instance
	// variation would cost every declaration site a second argument to buy nothing.
	ReporterCapacity : UDINT := 4;
	// Suites a TestRun can hold. A project usually has a handful - unit, motion,
	// I/O - so this is small on purpose, and overridable per instance as a generic
	// argument like Capacity.
	SuiteCapacity	 : UDINT := 8;
	// Scans a suite may go WITHOUT COMPLETING A TEST before the run abandons it.
	//
	// Not scans since the suite started - that would fire on a slow suite rather
	// than a stuck one. A rig suite waiting on hardware can sit for minutes and be
	// perfectly healthy, but it still finishes its tests one at a time; a stalled one
	// finishes none.
	//
	// Generous on purpose. This is a BACKSTOP: per-test deadlines already bound
	// every test that did not disable them, so the only things left for this to catch
	// are a framework defect and a test that turned its own deadlines off and hung.
	// A single legitimate test that takes longer than this needs it raised.
	//
	// Zero disables it, like every other deadline in this library.
	SuiteWatchdogCycles : UDINT := 60000;
END_VAR]]></Declaration>
  </GVL>
</TcPlcObject>